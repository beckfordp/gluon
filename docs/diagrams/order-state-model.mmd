flowchart LR
    START(("POST /orders 201"))
    AUTHORIZED(["authorized"])
    DISPATCHED(["dispatched"])
    CONFIRMED(["confirmed"])
    PAYMENT_FAILED(["payment_failed"])
    CANCELLED(["cancelled"])
    DISPATCH_FAILED(["dispatch_failed"])
    END(("end"))

    START -->|"reserve + authorize sync;<br/>persisted only on success"| AUTHORIZED

    AUTHORIZED -->|"DispatchConfirmed"| DISPATCHED
    AUTHORIZED -->|"PaymentCaptured"| CONFIRMED
    DISPATCHED -->|"PaymentCaptured"| CONFIRMED
    AUTHORIZED -->|"PaymentFailed"| PAYMENT_FAILED
    DISPATCHED -->|"PaymentFailed"| PAYMENT_FAILED
    AUTHORIZED -->|"DispatchFailed + release"| DISPATCH_FAILED
    AUTHORIZED -->|"PATCH/PUT cancel"| CANCELLED
    AUTHORIZED -.->|"PaymentAuthorizationExpired<br/>US-20 — not yet built (no producer)"| CANCELLED

    CONFIRMED --> END
    PAYMENT_FAILED --> END
    CANCELLED --> END
    DISPATCH_FAILED --> END

    LEGACY["pending · reserved · reservation_failed<br/>(legacy load-only; never written by current code)"]
    NOTE["solid = built transition · dashed = US-20 — not yet built<br/>Checkout failures never create an order: 400 invalid / unknown payment method,<br/>402 declined, 409 out of stock, 503 upstream down (any reservation is released).<br/>PaymentCaptured/PaymentFailed are accepted from authorized or dispatched."]

    classDef built fill:#ffffff,stroke:#28253D,stroke-width:2px
    classDef terminal fill:#eef2ff,stroke:#4f46e5,stroke-width:2px
    classDef legacy fill:#f4f4f4,stroke:#999999,stroke-dasharray:5 4
    classDef note fill:#f4f4f4,stroke:#999999
    class AUTHORIZED,DISPATCHED built
    class CONFIRMED,PAYMENT_FAILED,CANCELLED,DISPATCH_FAILED terminal
    class LEGACY legacy
    class NOTE note
