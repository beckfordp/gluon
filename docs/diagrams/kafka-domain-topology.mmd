flowchart LR
    G["gshop<br/>(storefront + admin)"]

    subgraph services["Services"]
        O["order-service"]
        I["inventory-service"]
        P["payment-service"]
        F["fulfilment-service"]
        N["notification-service"]
        U["user-service"]
    end

    subgraph topics["Kafka domain topics<br/>(one topic per domain + shared envelope)"]
        OE[("order-events")]
        PE[("payment-events")]
        FE[("fulfilment-events")]
        UE[("user-events")]
    end

    SWEEP["auth-expiry sweep<br/>US-20.1 — built"]

    G -->|"POST /orders<br/>GET/PATCH/PUT/DELETE /orders/{id}"| O
    G -->|"POST /payments/methods"| P
    G -->|"POST /auth/signup · POST /auth/login"| U
    G -->|"admin stock: GET/PATCH /inventorys"| I
    G -->|"operator queue: /fulfilment-tasks"| F
    O -->|"POST /inventorys/order-reservations<br/>(bulk, sync) + /{orderId}/release"| I
    O -->|"POST /payments/authorize<br/>(sync)"| P
    F -->|"GET /orders/{id}<br/>(snapshot)"| O

    O -->|"OrderConfirmed · OrderPaymentFailed · OrderCancelled<br/>(outbox/Debezium)"| OE
    P -->|"PaymentAuthorized · PaymentCaptured · PaymentFailed<br/>(outbox/Debezium)"| PE
    F -->|"DispatchConfirmed · DispatchFailed<br/>(outbox/Debezium)"| FE
    U -->|"UserRegistered<br/>(outbox/Debezium)"| UE

    OE -->|"OrderCancelled (void)"| P
    OE -->|"OrderCancelled (release)"| I
    OE -->|"OrderCancelled (abort)"| F
    OE -->|"OrderConfirmed · OrderPaymentFailed · OrderCancelled"| N
    PE -->|"PaymentCaptured · PaymentFailed"| O
    PE -->|"PaymentAuthorized"| F
    PE -->|"PaymentCaptured · PaymentFailed"| N
    FE -->|"DispatchConfirmed · DispatchFailed"| O
    FE -->|"DispatchConfirmed · DispatchFailed"| P
    FE -->|"DispatchConfirmed · DispatchFailed"| N
    UE -->|"UserRegistered"| N

    SWEEP -->|"PaymentAuthorizationExpired<br/>(outbox/Debezium)"| PE
    PE -->|"PaymentAuthorizationExpired"| O

    NOTE["All edges shown are built.<br/>Order events are per-outcome (TD-15); order-service learns authorize synchronously, not from PaymentAuthorized.<br/>inventory-service publishes nothing (no event topic, TD-22) but consumes OrderCancelled to release reservations.<br/>OrderCancelled is US-9's shared fan-out: payment void, inventory release, fulfilment abort, notification copy.<br/>Dispatch outcomes stay on fulfilment-events and are not mirrored into order-events.<br/>catalog-service and cart-service publish nothing and are omitted."]

    classDef service fill:#ffffff,stroke:#28253D,stroke-width:2px
    classDef topic fill:#fff5ad,stroke:#FACC15,stroke-width:2px
    classDef notbuilt fill:#fff7ed,stroke:#b45309,stroke-width:2px,stroke-dasharray:5 4
    classDef note fill:#f4f4f4,stroke:#999999
    class O,I,P,F,N,U service
    class OE,PE,FE,UE topic
    class SWEEP service
    class NOTE note
