{
  "producer": "payment-service",
  "groupId": "gluon",
  "artifacts": [
    {
      "artifactId": "payment-events-PaymentAuthorizationExpired",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "PaymentAuthorizationExpiredEvent",
            "description": "Authorization lapsed uncaptured: found by the background expiry sweep.",
            "type": "object",
            "required": [
              "orderId",
              "timestamp"
            ],
            "properties": {
              "orderId": {
                "description": "Order UUID (order-service's order id).",
                "examples": [
                  "3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f"
                ],
                "type": "string"
              },
              "timestamp": {
                "description": "When the sweep expired the hold (ISO-8601 instant).",
                "examples": [
                  "2026-10-31T10:15:30Z"
                ],
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "artifactId": "payment-events-PaymentAuthorized",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "PaymentAuthorizedEvent",
            "description": "Funds held: POST /payments/authorize succeeded. Consumed by fulfilment-service to start pick/pack.",
            "type": "object",
            "required": [
              "orderId",
              "authId",
              "expiresAt",
              "timestamp"
            ],
            "properties": {
              "orderId": {
                "description": "Order UUID (order-service's order id).",
                "examples": [
                  "3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f"
                ],
                "type": "string"
              },
              "authId": {
                "description": "Payment provider's authorization reference.",
                "examples": [
                  "auth-7f3a9c"
                ],
                "type": "string"
              },
              "expiresAt": {
                "description": "When the hold lapses if never captured (ISO-8601 instant).",
                "examples": [
                  "2026-11-07T10:15:30Z"
                ],
                "type": "string",
                "format": "date-time"
              },
              "timestamp": {
                "description": "When the authorization was made (ISO-8601 instant).",
                "examples": [
                  "2026-10-31T10:15:30Z"
                ],
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "artifactId": "payment-events-PaymentCaptured",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "PaymentCapturedEvent",
            "description": "Money moved: capture succeeded after DispatchConfirmed. Published once per order.",
            "type": "object",
            "required": [
              "orderId",
              "amountCents",
              "timestamp"
            ],
            "properties": {
              "orderId": {
                "description": "Order UUID (order-service's order id).",
                "examples": [
                  "3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f"
                ],
                "type": "string"
              },
              "amountCents": {
                "description": "Amount captured, in cents.",
                "examples": [
                  4999
                ],
                "type": "integer",
                "format": "int32"
              },
              "timestamp": {
                "description": "When the capture happened (ISO-8601 instant).",
                "examples": [
                  "2026-10-31T10:15:30Z"
                ],
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "artifactId": "payment-events-PaymentFailed",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "PaymentFailedEvent",
            "description": "Capture declined after DispatchConfirmed. Authorize declines are synchronous and publish nothing.",
            "type": "object",
            "required": [
              "orderId",
              "paymentId",
              "amountCents",
              "reason",
              "timestamp"
            ],
            "properties": {
              "orderId": {
                "description": "Order UUID (order-service's order id).",
                "examples": [
                  "3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f"
                ],
                "type": "string"
              },
              "paymentId": {
                "description": "payment-service's own Payment id, for log/trace correlation only.",
                "examples": [
                  "9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d"
                ],
                "type": "string"
              },
              "amountCents": {
                "description": "Amount that failed to charge, in cents.",
                "examples": [
                  4999
                ],
                "type": "integer",
                "format": "int32"
              },
              "reason": {
                "description": "Failure reason.",
                "examples": [
                  "capture_failed"
                ],
                "type": "string"
              },
              "timestamp": {
                "description": "When the capture was declined (ISO-8601 instant).",
                "examples": [
                  "2026-10-31T10:15:30Z"
                ],
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
