{
  "producer": "fulfilment-service",
  "groupId": "gluon",
  "artifacts": [
    {
      "artifactId": "fulfilment-events-DispatchConfirmed",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "DispatchConfirmedEvent",
            "description": "Order dispatched: pick/pack/dispatch succeeded. Carries a full item snapshot so consumers need no order lookup.",
            "type": "object",
            "required": [
              "orderId",
              "trackingNo"
            ],
            "properties": {
              "orderId": {
                "description": "Order UUID (order-service's order id).",
                "examples": [
                  "3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f"
                ],
                "type": "string"
              },
              "trackingNo": {
                "description": "Carrier tracking number.",
                "examples": [
                  "TRK-123456789"
                ],
                "type": "string"
              },
              "items": {
                "description": "Items dispatched. Always sent.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "sku",
                    "productName",
                    "quantity",
                    "unitPriceCents"
                  ],
                  "properties": {
                    "sku": {
                      "description": "Product SKU.",
                      "examples": [
                        "SKU-0042"
                      ],
                      "type": "string"
                    },
                    "productName": {
                      "description": "Product name at dispatch time.",
                      "examples": [
                        "Espresso cup"
                      ],
                      "type": "string"
                    },
                    "quantity": {
                      "description": "Units dispatched.",
                      "examples": [
                        2
                      ],
                      "type": "integer",
                      "format": "int32"
                    },
                    "unitPriceCents": {
                      "description": "Unit price, in cents.",
                      "examples": [
                        1250
                      ],
                      "type": "integer",
                      "format": "int32"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "version": "2",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "DispatchConfirmedEvent",
            "description": "Order dispatched: pick/pack/dispatch succeeded. Carries a full item snapshot so consumers need no order lookup.",
            "type": "object",
            "required": [
              "orderId",
              "trackingNo"
            ],
            "properties": {
              "orderId": {
                "description": "Order UUID (order-service's order id).",
                "examples": [
                  "3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f"
                ],
                "type": "string"
              },
              "trackingNo": {
                "description": "Carrier tracking number.",
                "examples": [
                  "TRK-123456789"
                ],
                "type": "string"
              },
              "items": {
                "description": "Items dispatched. Always sent.",
                "type": "array",
                "items": {
                  "description": "One order line as snapshotted when the task was created.",
                  "type": "object",
                  "required": [
                    "sku",
                    "productName",
                    "quantity",
                    "unitPriceCents"
                  ],
                  "properties": {
                    "sku": {
                      "description": "Product SKU.",
                      "examples": [
                        "SKU-0042"
                      ],
                      "type": "string"
                    },
                    "productName": {
                      "description": "Product name at dispatch time.",
                      "examples": [
                        "Espresso cup"
                      ],
                      "type": "string"
                    },
                    "quantity": {
                      "description": "Units dispatched.",
                      "examples": [
                        2
                      ],
                      "type": "integer",
                      "format": "int32"
                    },
                    "unitPriceCents": {
                      "description": "Unit price, in cents.",
                      "examples": [
                        1250
                      ],
                      "type": "integer",
                      "format": "int32"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "artifactId": "fulfilment-events-DispatchFailed",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "DispatchFailedEvent",
            "description": "Dispatch failed: pick/pack/dispatch hit an error. payment-service voids the hold; order-service marks the order failed.",
            "type": "object",
            "required": [
              "orderId",
              "reason"
            ],
            "properties": {
              "orderId": {
                "description": "Order UUID (order-service's order id).",
                "examples": [
                  "3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f"
                ],
                "type": "string"
              },
              "reason": {
                "description": "Why dispatch failed.",
                "examples": [
                  "carrier_unavailable"
                ],
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
