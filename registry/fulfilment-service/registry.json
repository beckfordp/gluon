{
  "producer": "fulfilment-service",
  "groupId": "gluon",
  "artifacts": [
    {
      "artifactId": "fulfilment-events-DispatchConfirmed",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "DispatchConfirmedEvent",
            "type": "object",
            "required": [
              "orderId",
              "trackingNo"
            ],
            "properties": {
              "orderId": {
                "type": "string"
              },
              "trackingNo": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "sku",
                    "productName",
                    "quantity",
                    "unitPriceCents"
                  ],
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "productName": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "unitPriceCents": {
                      "type": "integer",
                      "format": "int32"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "artifactId": "fulfilment-events-DispatchFailed",
      "artifactType": "JSON",
      "rules": {
        "COMPATIBILITY": "BACKWARD_TRANSITIVE"
      },
      "versions": [
        {
          "version": "1",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "DispatchFailedEvent",
            "type": "object",
            "required": [
              "orderId",
              "reason"
            ],
            "properties": {
              "orderId": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
