#!/usr/bin/env python3
# SPDX-License-Identifier: MIT

"""Export gluon and the repos the sandbox ports need, for upload (docs/sandbox.md).

Laptop side; the reverse of bin/sandbox-save. Re-runnable: with no arguments it
replaces the previous export in DEFAULT_OUT and writes DEFAULT_OUT.tar.gz.

The nested repos exported are bin/lib/sandbox.py's SHARED_REPOS and both sides of
each of its PORTS (the Rust side once it exists on the laptop). Exported files
naming another nested repo are listed as warnings: a script the sandbox runs may
need that repo too.

The export holds each repo's tracked files as committed: no .git, no build
output, nothing untracked, and none of EXPORT_EXCLUDES. Every repo must be
clean: no uncommitted changes and no untracked files, bar never-exported
names and LOCAL_ONLY. Laptop captures (~/<service>-contracts-YYYYMMDD) not yet committed to
tests/contract are added under tests/contract/contracts/<service>/<date>/, to
be committed in the sandbox.

Before anything is written, every file is scanned for private-looking data.
A match no allow-rule explains stops the export. EXPORT-REVIEW.md, written at
the export's root, lists what was exported, what was left out, and every
allowed match with the reason it's fine, for the sandbox reviewer.

Usage:
  bin/sandbox-export [--out DIR] [--clean] [--capture SERVICE=DIR ...]
                     [--no-auto-captures] [--no-archive] [--session RPN-N] [--yes]

First, untracked files and build output (BUILD_DIRS) in those repos are listed
and, once confirmed (or with --yes), removed; KEPT and LOCAL_ONLY never are.
Binary files outside ALLOWED_BINARIES stop the export.

No plan travels: PLAN.md, the perf sequence, TECHNICAL_DEBT.md, CHANGELOG.md,
docs/sandbox.md, this script and its tests (bin/verify-complete-RPN-0.1.sh) stay on the laptop, read-only repos lose conductor/, and working repos (SANDBOX_REPOS) lose
conductor/archive/ and their tracks.md backlog. The one session (default:
the first unchecked sandbox session) is written beside the export, not in it, as
RPN-N-plan.md: the Rust Port section's rules, the session and a scope fence,
to paste as the sandbox plan.

DIR must be empty, missing, or a previous export (it holds EXPORT-MANIFEST.json);
--clean empties any other DIR first (refused if it holds a .git).
"""

import argparse
import json
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from collections import Counter
from collections.abc import Sequence
from dataclasses import dataclass
from datetime import UTC, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from sandbox import GLUON, NESTED_REPO_DIRS, PLATFORM_EXCLUDES, SANDBOX_REPOS, export_repos, git_repos

DEFAULT_OUT = GLUON.parent / "sandbox" / "workspace" / "gluon"
"""Where the upload is staged on the laptop."""

MANIFEST = "EXPORT-MANIFEST.json"
REVIEW = "EXPORT-REVIEW.md"

PLAN_SECTION = "## Rust Port — notification-service"
"""The PLAN.md section whose sessions run in the sandbox."""

SESSION_HEADING = re.compile(r"^### (RPN-[\w.]+) — ", re.M)
"""A session's heading in that section (`RPN-1`, `RPN-0.1`); laptop sessions are `RPN-L…`."""

LOCAL_ONLY = frozenset({Path("contract.sh"), Path("contract-notification.sh")})
"""Untracked gluon files allowed at export: the laptop capture scripts, which travel
inside their captures as CAPTURE.sh."""

NOT_EXPORTED = frozenset(
    {
        Path("PLAN.md"),
        Path("perf-work-sequence.md"),
        Path("TECHNICAL_DEBT.md"),
        Path("CHANGELOG.md"),
        Path("docs") / "sandbox.md",
        Path("bin") / "sandbox-export",
        Path("bin") / "verify-complete-RPN-0.1.sh",
    }
)
"""gluon files that stay on the laptop: plans the sandbox model would run ahead on,
history and sandbox how-to it doesn't need, and this script and its tests, which show how
the session plan is made."""

CONDUCTOR = Path("conductor")
"""Each repo's Conductor directory: dropped from read-only repos, trimmed in working ones."""

SCOPE_FENCE = (
    "## Scope\n\n"
    "Do only this session. No other plan, backlog or sequence exists for you; don't start "
    "further work. Done = the \"Done when\" script prints PASS, then review, conductor "
    "archive and `bin/sandbox-save`; then stop and report."
)
"""Closes the session plan: the sandbox model stops at the session's end."""

EXPORT_EXCLUDES = PLATFORM_EXCLUDES | {".claude", ".bsp", "structure101-settings.java.hsw"}
"""Names never exported: VCS data, build output, editor and assistant state."""

CAPTURE_DIR = re.compile(r"^(?P<service>[a-z][a-z0-9-]*)-contracts-(?P<date>\d{8})$")
"""A laptop capture's output directory in the home directory."""

CAPTURE_JUNK = re.compile(r"^(\._.*|\.DS_Store)$")
"""macOS metadata files dropped from captures."""

VENDORED = re.compile(r"(swagger-ui|asyncapi-ui)[\w.-]*\.js$|/asyncapi-html/js/")
"""Minified upstream JS: its version strings and constants look like IP addresses."""

CHECKS: dict[str, re.Pattern[str]] = {
    "email": re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"),
    "home path": re.compile(r"/(?:Users|home)/[\w.<>…-]+"),
    "owner name": re.compile(r"(?i)beckford\w*|\bpaul\b"),
    "private key": re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    "github token": re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}|\bgithub_pat_[A-Za-z0-9_]{30,}"),
    "aws key": re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    "jwt": re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}"),
    "private ip": re.compile(r"\b(?:10\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])|192\.168)\.\d{1,3}\.\d{1,3}\b"),
}
"""What the scan looks for (docs/private-data-report.md, "How it was checked")."""


@dataclass(frozen=True)
class Rule:
    """One allow-rule: which matches it explains, and why they are fine."""

    check: str
    label: str
    why: str
    pattern: re.Pattern[str]
    only_in: re.Pattern[str] | None = None
    line_must_contain: str | None = None


RULES = (
    Rule("email", "`@example.com`, `.example`, `.org`/`.net` example domains",
         "Reserved for documentation and testing (RFC 2606); no mailbox exists. Names are made up.",
         re.compile(r"(?i)@(?:[\w-]+\.)*example(?:\.com|\.org|\.net)?$")),
    Rule("email", "`local@host.tld`, `local@domain.tld`, `a@b.c`, `x@y.z`",
         "Format-only addresses in e-mail validation tests and doc comments; not real domains.",
         re.compile(r"@(?:host\.tld|domain\.tld|b\.c|y\.z)$")),
    Rule("email", "`sandbox@gluon.local`",
         "The git identity for commits made in the sandbox; `.local` isn't routable.",
         re.compile(r"^sandbox@gluon\.local$")),
    Rule("email", "`support@asyncapi.org`, `i@izs.me`",
         "Contacts of upstream open-source projects, published in their packages.",
         re.compile(r"^(?:support@asyncapi\.org|i@izs\.me)$")),
    Rule("email", "`a@b.co`, `first+tag@sub.example.co.uk` in the private-data report",
         "The report's \"Was\" column: values already replaced everywhere else.",
         re.compile(r"^(?:a@b\.co|first\+tag@sub\.example\.co\.uk)$"),
         only_in=re.compile(r"^docs/private-data-report\.md$")),
    Rule("home path", "`/Users/<user>`, `/Users/…`, `/home/…`",
         "Placeholders that replaced the laptop path, or generic examples.",
         re.compile(r"^/(?:Users|home)/(?:<user>|…)$")),
    Rule("home path", "`/home/model`, `/home/claude`, `/home/x`",
         "Paths inside the sandbox machine, or a dummy `HOME` in tests.",
         re.compile(r"^/home/(?:model|claude|x)$")),
    Rule("owner name", "GitHub handle `beckfordp`",
         "The project's public GitHub account and package namespace (`io.github.beckfordp`).",
         re.compile(r"(?i)^beckfordp$")),
    Rule("owner name", "`Copyright (c) 2026 Paul Beckford` in `LICENSE`",
         "The attribution the MIT licence requires; already published with each repo.",
         re.compile(r"(?i)^(?:paul|beckford)$"), only_in=re.compile(r"(?:^|/)LICENSE$"),
         line_must_contain="Copyright (c) 2026 Paul Beckford"),
    Rule("private ip", "IP-like numbers in minified upstream JS",
         "Version strings and constants in vendored Swagger UI / AsyncAPI UI bundles.",
         re.compile(r"."), only_in=VENDORED),
)
"""Every allowed kind of match; EXPORT-REVIEW.md reproduces this table."""

ALLOWED_BINARIES = (
    (re.compile(r"/assets/swagger-ui/favicon-\d+x\d+\.png$"), "Swagger UI's favicons, vendored with its webjar and served by `/docs`."),
    (re.compile(r"^tests/contract/contracts/[^/]+/\d{8}/otlp/\d+\.pb$"), "Captured OTLP trace exports (protobuf), decoded by the harness."),
)
"""The only binary files an export may hold; anything else stops it."""

REF_ALLOWED = (
    (re.compile(r"^bin/(?:codegen|generate-service|run-acceptance|run-perf|reset-data)$"),
     "Laptop-only scripts: the service generator, the acceptance and perf runners, the full-stack reseed."),
    (re.compile(r"^(?:bin/lib/obs-budget\.sh|infra/k8s/.*\.ya?ml|lib/purerest/build\.sbt)$"),
     "Comments pointing at another service as an example."),
)
"""Files whose references to repos not exported are known to be harmless, and why."""

BUILD_DIRS = frozenset({"target", ".bsp", "__pycache__", ".metals", ".bloop"})
"""Build-output directory names offered for removal before an export."""

KEPT = frozenset({".claude", ".venv", "node_modules"})
"""Never removed: assistant state and dev environments (none is exported)."""

LEFT_OUT = (
    ("`.git` in every repo", "No history leaves the laptop; early harness history holds pre-redaction capture values."),
    ("Build output: `target/`, `.bsp/`, `node_modules/`, `.venv/`, `__pycache__/`", "Transient, and `.bsp/sbt.json` holds laptop paths."),
    ("Untracked files", "Not reviewed work: local capture scripts (`contract*.sh`), stray specs."),
    ("`.claude/`, `.idea/`, `.obsidian/`, `.DS_Store`, `structure101-settings.java.hsw`", "Editor, IDE and assistant state; `.idea` holds laptop paths."),
    ("Repos not in `PORTS` or `SHARED_REPOS` (`bin/lib/sandbox.py`)", "Not part of a port: the other services, `frontends/`, `tools/`, the other test suites."),
    ("`PLAN.md`, `perf-work-sequence.md`, `TECHNICAL_DEBT.md`", "Plans the sandbox model ran ahead on."),
    ("`CHANGELOG.md`, `docs/sandbox.md`", "History and the sandbox how-to: for the laptop, not the sandbox model."),
    ("`bin/sandbox-export`, `bin/verify-complete-RPN-0.1.sh`", "Laptop-only: the export and its tests."),
    ("`conductor/` in read-only repos", "Their tracks, backlogs and archived plans; nothing is built there."),
    ("`conductor/archive/` and the `tracks.md` backlog in working repos", "Past and future work the sandbox model would pick up; active tracks and `workflow.md` stay."),
)
"""What the export leaves out and why; reproduced in EXPORT-REVIEW.md."""

CAPTURE_EDITS = (
    ("`stdout.log`, `CAPTURE.sh`", "laptop paths in JVM warnings and the script", "`/Users/<user>/<path-to>/gluon/…`"),
    ("`kafka/consumer-groups.txt`", "consumer client hosts (Docker-network addresses)", "`192.0.2.1` (RFC 5737 documentation address)"),
)
"""Redactions the capture scripts make before packing; reproduced in EXPORT-REVIEW.md."""


def git(repo: Path, *args: str) -> str:
    """Runs git in `repo`, returning stdout."""
    return subprocess.run(
        ["git", "-C", str(repo), *args], capture_output=True, text=True, check=True
    ).stdout


def excluded(relative: Path) -> bool:
    """True for a path under any EXPORT_EXCLUDES name."""
    return any(part in EXPORT_EXCLUDES for part in relative.parts)


def tracked(repo: Path) -> list[Path]:
    """The repo's tracked files that exist, minus exclusions, relative to the repo."""
    paths = [Path(name) for name in git(repo, "ls-files", "-z").split("\0") if name]
    return [p for p in paths if (repo / p).is_file() and not (repo / p).is_symlink() and not excluded(p)]


def platform() -> list[Path]:
    """gluon's own tracked files: the nested repos' directories only contribute their README.md."""
    return [
        p
        for p in tracked(GLUON)
        if (p.parts[0] not in NESTED_REPO_DIRS or p == Path(p.parts[0]) / "README.md")
        and p not in NOT_EXPORTED
    ]


def conductor_files(repo: Path, files: list[Path]) -> list[Path]:
    """`files` without what CONDUCTOR holds beyond a working repo's live tracks."""
    working = repo.relative_to(GLUON) in SANDBOX_REPOS
    return [
        p
        for p in files
        if not p.is_relative_to(CONDUCTOR) or (working and not p.is_relative_to(CONDUCTOR / "archive"))
    ]


def strip_backlog(text: str) -> str:
    """tracks.md without its Backlog items and intro; the heading stays as patch context."""
    start = text.find("\n## Backlog")
    if start < 0:
        return text
    following = text.find("\n## ", start + 1)
    end = following if following >= 0 else len(text)
    return text[:start] + "\n## Backlog\n" + text[end:]


def session_plan(session: str | None) -> tuple[str, str]:
    """The session's id and plan: the section's rules and inputs, that session, then SCOPE_FENCE.

    Without `session`, the first sandbox session with an unchecked item.
    """
    text = (GLUON / "PLAN.md").read_text()
    start = text.find(PLAN_SECTION)
    if start < 0:
        raise SystemExit(f"PLAN.md has no '{PLAN_SECTION}' section")
    following = text.find("\n## ", start + len(PLAN_SECTION))
    section = text[start : following if following >= 0 else len(text)].rstrip().removesuffix("---").rstrip()
    headings = list(SESSION_HEADING.finditer(section))
    if not headings:
        raise SystemExit(f"'{PLAN_SECTION}' has no sessions")
    intro = section[len(PLAN_SECTION) : headings[0].start()].strip()
    bounds = zip(headings, [*(h.start() for h in headings[1:]), len(section)], strict=True)
    blocks = {h.group(1): section[h.start() : end].strip() for h, end in bounds}
    if session is None:
        pending = [s for s, block in blocks.items() if not s.startswith("RPN-L") and "- [ ]" in block]
        if not pending:
            raise SystemExit("No sandbox session left unchecked in PLAN.md; pass --session")
        session = pending[0]
    if session not in blocks:
        raise SystemExit(f"--session {session}: not in PLAN.md (have {', '.join(blocks)})")
    plan = "\n\n".join(
        [
            f"# Sandbox session — {session}",
            f"From gluon's `PLAN.md` (\"{PLAN_SECTION.removeprefix('## ')}\") by "
            "`bin/sandbox-export`.",
            "## Rules and inputs",
            intro,
            "## This session",
            blocks[session],
            SCOPE_FENCE,
        ]
    )
    return session, plan + "\n"


def dirty(repo: Path) -> list[str]:
    """Uncommitted changes to tracked files (untracked ones are `removable`)."""
    return git(repo, "status", "--porcelain", "--untracked-files=no").splitlines()


def removable(repo: Path) -> list[Path]:
    """Untracked files and build-output directories in `repo`, bar KEPT and LOCAL_ONLY.

    In gluon, the nested repos' directories are ignored as a whole and never offered.
    """
    def offered(relative: Path) -> bool:
        if any(part in KEPT for part in relative.parts):
            return False
        if repo == GLUON and (relative in LOCAL_ONLY or relative.parts[0] in NESTED_REPO_DIRS):
            return False
        return True

    untracked = [Path(p) for p in git(repo, "ls-files", "-z", "--others", "--exclude-standard").split("\0") if p]
    ignored = git(repo, "ls-files", "-z", "--others", "--ignored", "--exclude-standard", "--directory")
    build = [Path(p) for p in ignored.split("\0") if p.endswith("/") and Path(p).name in BUILD_DIRS]
    return [repo / p for p in sorted({*untracked, *build}) if offered(p)]


def size(path: Path) -> int:
    """Bytes under `path`."""
    if path.is_file():
        return path.stat().st_size
    return sum(p.stat().st_size for p in path.rglob("*") if p.is_file() and not p.is_symlink())


def clean(repos: Sequence[Path], yes: bool) -> None:
    """Lists untracked files and build output, and removes them once confirmed; stops if not."""
    found = [path for repo in repos for path in removable(repo)]
    if not found:
        print("clean     no untracked files or build output")
        return
    total = 0
    for path in found:
        total += (bytes_ := size(path))
        kind = "dir " if path.is_dir() else "file"
        print(f"remove?   {kind} {path.relative_to(GLUON)} ({bytes_ / 2**20:.1f} MiB)")
    prompt = f"Remove these {len(found)} ({total / 2**20:.0f} MiB)? [y/N] "
    if not yes:
        if not sys.stdin.isatty():
            raise SystemExit("Not removed: no terminal to confirm; re-run with --yes, or remove them yourself")
        if input(prompt).strip().lower() not in ("y", "yes"):
            raise SystemExit("Not removed; nothing exported")
    for path in found:
        shutil.rmtree(path) if path.is_dir() and not path.is_symlink() else path.unlink()
    print(f"removed   {len(found)} paths ({total / 2**20:.0f} MiB)")


def rule_for(check: str, match: str, line: str, relative: Path) -> Rule | None:
    """The allow-rule that explains this match, if any."""
    for rule in RULES:
        if rule.check not in (check, "*") or not rule.pattern.search(match):
            continue
        if rule.only_in is not None and not rule.only_in.search(relative.as_posix()):
            continue
        if rule.line_must_contain is not None and rule.line_must_contain not in line:
            continue
        return rule
    return None


def scan(staging: Path) -> tuple[list[str], Counter[Rule], Counter[str]]:
    """Unexplained matches and binaries (`path:line: check: match`), how often each rule
    allowed a match, and how many binaries each ALLOWED_BINARIES reason covers."""
    findings: list[str] = []
    allowed: Counter[Rule] = Counter()
    binaries: Counter[str] = Counter()
    for path in sorted(p for p in staging.rglob("*") if p.is_file()):
        relative = path.relative_to(staging)
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            why = next((w for pattern, w in ALLOWED_BINARIES if pattern.search(relative.as_posix())), None)
            if why is None:
                findings.append(f"{relative}: binary file")
            else:
                binaries[why] += 1
            continue
        for number, line in enumerate(text.splitlines(), 1):
            for check, pattern in CHECKS.items():
                for match in pattern.finditer(line):
                    rule = rule_for(check, match.group(0), line, relative)
                    if rule is None:
                        findings.append(f"{relative}:{number}: {check}: {match.group(0)[:80]}")
                    else:
                        allowed[rule] += 1
    return findings, allowed, binaries


def unexported_refs(staging: Path, exported: Sequence[Path]) -> tuple[list[str], Counter[str]]:
    """References in non-Markdown files to nested repos not in `exported` (`path:line: repo`),
    and how many references each REF_ALLOWED reason covers. Prose mentions are left out."""
    others = [repo.as_posix() for repo in git_repos() if repo not in exported]
    found: list[str] = []
    allowed: Counter[str] = Counter()
    if not others:
        return found, allowed
    pattern = re.compile(r"\b(" + "|".join(map(re.escape, others)) + r")\b")
    for path in sorted(p for p in staging.rglob("*") if p.is_file() and p.suffix != ".md"):
        relative = path.relative_to(staging).as_posix()
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        why = next((w for allowed_file, w in REF_ALLOWED if allowed_file.search(relative)), None)
        for number, line in enumerate(text.splitlines(), 1):
            for match in pattern.finditer(line):
                if why is None:
                    found.append(f"{relative}:{number}: {match.group(1)}")
                else:
                    allowed[why] += 1
    return found, allowed


def copy(files: list[Path], source: Path, target: Path) -> None:
    """Copies `files` (relative to `source`) under `target`, keeping modes."""
    for relative in files:
        destination = target / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source / relative, destination)


def finished(directory: Path) -> bool:
    """A capture is finished once its DIR.tgz, written last, is at least as new as every file in it."""
    packed = directory.parent / f"{directory.name}.tgz"
    if not packed.is_file():
        return False
    newest = max((p.stat().st_mtime for p in directory.rglob("*") if p.is_file()), default=0.0)
    return packed.stat().st_mtime >= newest


def found_captures() -> list[str]:
    """`SERVICE=DIR` for each finished home-directory capture not yet committed to tests/contract."""
    specs = []
    committed = GLUON / "tests" / "contract" / "contracts"
    for directory in sorted(Path.home().iterdir()):
        named = CAPTURE_DIR.match(directory.name)
        if named is None or not directory.is_dir():
            continue
        if (committed / named["service"] / named["date"]).exists():
            continue
        if not finished(directory):
            print(f"skipped   ~/{directory.name}: capture unfinished (no up-to-date .tgz)")
            continue
        specs.append(f"{named['service']}={directory}")
    return specs


def add_capture(spec: str, staging: Path) -> dict[str, object]:
    """Copies one `SERVICE=DIR` capture to tests/contract/contracts/<service>/<date>/."""
    service, _, directory = spec.partition("=")
    source = Path(directory).expanduser()
    date = re.search(r"(\d{8})$", source.name)
    if not service or not source.is_dir() or date is None:
        raise SystemExit(f"--capture {spec}: want SERVICE=DIR, DIR an existing *-YYYYMMDD directory")
    target = Path("tests") / "contract" / "contracts" / service / date.group(1)
    files = [
        p.relative_to(source)
        for p in sorted(source.rglob("*"))
        if p.is_file() and not any(CAPTURE_JUNK.match(part) for part in p.relative_to(source).parts)
    ]
    copy(files, source, staging / target)
    return {"service": service, "path": target.as_posix(), "source": source.name, "files": len(files)}


def review(
    manifest: dict[str, object], allowed: Counter[Rule], binaries: Counter[str], ref_allowed: Counter[str]
) -> str:
    """EXPORT-REVIEW.md: what the export holds and why what looks private isn't."""
    lines = [
        "# Export review",
        "",
        f"Generated by `bin/sandbox-export` on {manifest['created']}. Re-running the command",
        "regenerates this file.",
        "",
        "**Result:** no credentials, no personal data, no laptop paths. Every file was",
        "scanned for e-mail addresses, home paths, the owner's name, private keys, GitHub",
        "and AWS tokens, JWTs and private IP addresses; each match is explained below, and",
        "an unexplained match would have stopped the export.",
        "",
        "## Contents",
        "",
        "| Repo | Commit | Files |",
        "|---|---|---|",
    ]
    for repo in manifest["repos"]:  # type: ignore[union-attr]
        lines.append(f"| `{repo['path']}` | `{repo['head'][:7]}` | {repo['files']} |")
    captures = manifest["captures"]
    if captures:
        lines += ["", "Captures added (laptop output, to be committed in the sandbox):", ""]
        for capture in captures:  # type: ignore[union-attr]
            lines.append(f"- `{capture['path']}` from `{capture['source']}` ({capture['files']} files)")
        lines += [
            "",
            "Redacted by the capture script before packing (test data is made up: fixed",
            "UUIDs, `ada@example.com`, `guest@example.com`):",
            "",
            "| File | Was | Now |",
            "|---|---|---|",
        ]
        lines += [f"| {where} | {was} | {now} |" for where, was, now in CAPTURE_EDITS]
    lines += ["", "## Binary files", "", "| Files | Why they're allowed |", "|---|---|"]
    lines += [f"| {count} | {why} |" for why, count in binaries.items()] or ["| 0 | — |"]
    lines += ["", "## References to repos not exported", ""]
    refs = manifest["unexported_refs"]
    if refs:
        lines += ["Files the sandbox may run that name a repo it doesn't have; check each:", ""]
        lines += [f"- `{ref}`" for ref in refs]  # type: ignore[union-attr]
    else:
        lines += ["None outside the files below."]
    lines += ["", "| References | Why they're fine |", "|---|---|"]
    lines += [f"| {count} | {why} |" for why, count in ref_allowed.items()] or ["| 0 | — |"]
    lines += ["", "## Left out", "", "| What | Why |", "|---|---|"]
    lines += [f"| {what} | {why} |" for what, why in LEFT_OUT]
    lines += [
        "",
        "## Matches that look private, and why they aren't",
        "",
        "| Check | What | Matches | Why it's fine |",
        "|---|---|---|---|",
    ]
    lines += [f"| {r.check} | {r.label} | {allowed[r]} | {r.why} |" for r in RULES]
    lines += [
        "",
        "## Not matched by the scan, reviewed by hand",
        "",
        "| What | Where | Why it's fine |",
        "|---|---|---|",
        "| Test passwords (`correct-horse-battery-1`, `wrong-password-1`, `short`, `demo-password-1`, …) | tests, captures, verify scripts | Written for tests and published in them; protect nothing. |",
        "| DB passwords equal to the service name (`notification`, `user`, …) | `application.conf`, values files, tests | Throw-away local database defaults. |",
        "| `dev-operator-token`, `Bearer wrong-token` | fulfilment config, `bin/verify-admin-demo` | A named development default and a negative-test value. |",
        "| `EXAMPLE-access-token-…-not-real-…` | user-service capture | Placeholders that replaced captured tokens (`docs/private-data-report.md`). |",
        "| PBKDF2 hashes | user-service capture, tests | Of the published test password; a check depends on them (ADR 0028). |",
        "| Random UUIDs, trace ids, timestamps | captures, tests | Identifiers of throw-away test records. |",
        "| `*.svc.cluster.local`, `localhost`, `127.0.0.1` | scripts, values, captures | In-cluster and loopback names. |",
        "| \"MacBook Pro M1 Max, 10 cores\" | `PLAN.md` | A hardware spec for perf figures; identifies no one. |",
        "",
    ]
    return "\n".join(lines)


def export(out: Path, captures: Sequence[str], clean: bool, session: str | None) -> dict[str, object]:
    """Stages and scans the export, then empties `out` and writes it there, the session plan
    beside it; returns its manifest."""
    nested = export_repos()
    repos = [GLUON, *(GLUON / r for r in nested)]
    unclean = {r.relative_to(GLUON).as_posix(): d for r in repos if (d := dirty(r))}
    if unclean:
        lines = "\n".join(f"  {repo}: {change}" for repo, changes in unclean.items() for change in changes)
        raise SystemExit(f"Uncommitted changes; commit or stash first:\n{lines}")
    session, plan = session_plan(session)
    manifest: dict[str, object] = {
        "created": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "session": session,
    }
    with tempfile.TemporaryDirectory() as scratch:
        staging = Path(scratch) / "gluon"
        staging.mkdir()
        entries = []
        for repo in repos:
            relative = repo.relative_to(GLUON)
            files = platform() if repo == GLUON else conductor_files(repo, tracked(repo))
            copy(files, repo, staging / relative)
            tracks = staging / relative / CONDUCTOR / "tracks.md"
            if repo != GLUON and tracks.is_file():
                tracks.write_text(strip_backlog(tracks.read_text()))
            head = git(repo, "rev-parse", "HEAD").strip()
            entries.append({"path": relative.as_posix(), "head": head, "files": len(files)})
            print(f"copied    {relative} @ {head[:7]} ({len(files)} files)")
        manifest["repos"] = entries
        manifest["captures"] = [add_capture(spec, staging) for spec in captures]
        for capture in manifest["captures"]:  # type: ignore[union-attr]
            print(f"captured  {capture['path']} ({capture['files']} files)")
        findings, allowed, binaries = scan(staging)
        if findings:
            print("\n".join(findings))
            raise SystemExit(f"\n{len(findings)} unexplained private-data match(es); nothing written.")
        print(f"scanned   {sum(allowed.values())} allowed matches, none unexplained")
        refs, ref_allowed = unexported_refs(staging, nested)
        manifest["unexported_refs"] = refs
        for ref in refs:
            print(f"warn      {ref}: names a repo not exported")
        (staging / MANIFEST).write_text(json.dumps(manifest, indent=2) + "\n")
        (staging / REVIEW).write_text(review(manifest, allowed, binaries, ref_allowed))
        empty(out, clean)
        out.mkdir(parents=True, exist_ok=True)
        for item in staging.iterdir():
            shutil.move(str(item), out / item.name)
    path = out.parent / f"{session}-plan.md"
    path.write_text(plan)
    print(f"plan      {path}: paste as the sandbox plan")
    return manifest


def empty(out: Path, clean: bool) -> None:
    """Makes sure `out` is empty: a previous export is always emptied, anything else only with `clean`."""
    if not out.exists() or not any(out.iterdir()):
        return
    if not clean and not (out / MANIFEST).is_file():
        raise SystemExit(f"{out} isn't empty and isn't a previous export; pass --clean to empty it")
    if any(out.rglob(".git")):
        raise SystemExit(f"{out} holds a .git; refusing to empty it")
    for item in out.iterdir():
        shutil.rmtree(item) if item.is_dir() and not item.is_symlink() else item.unlink()
    print(f"emptied   {out}")


def main(argv: Sequence[str]) -> int:
    """Parses arguments and exports."""
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT, help=f"default: {DEFAULT_OUT}")
    parser.add_argument("--clean", action="store_true", help="empty a non-export --out first")
    parser.add_argument("--capture", action="append", default=[], metavar="SERVICE=DIR")
    parser.add_argument("--no-auto-captures", action="store_true", help="skip ~/*-contracts-YYYYMMDD")
    parser.add_argument("--no-archive", action="store_true", help="don't write OUT.tar.gz")
    parser.add_argument("--session", help="PLAN.md session for RPN-N-plan.md (default: next unchecked)")
    parser.add_argument("--yes", action="store_true", help="remove untracked files and build output unasked")
    args = parser.parse_args(argv)
    out = args.out.expanduser().resolve()
    if out == GLUON or GLUON in out.parents:
        raise SystemExit("--out must be outside gluon")
    captures = list(args.capture)
    if not args.no_auto_captures:
        captures += [spec for spec in found_captures() if spec not in captures]
    if out.exists() and any(out.iterdir()) and not args.clean and not (out / MANIFEST).is_file():
        raise SystemExit(f"{out} isn't empty and isn't a previous export; pass --clean to empty it")
    clean([GLUON, *(GLUON / r for r in export_repos())], args.yes)
    export(out, captures, args.clean, args.session)
    print(f"\nExported to {out}; reviewer note: {out / REVIEW}")
    if not args.no_archive:
        archive = out.parent / f"{out.name}.tar.gz"
        with tarfile.open(archive, "w:gz") as tar:
            tar.add(out, arcname=out.name)
        print(f"Archived  {archive} ({archive.stat().st_size // 1024} KiB)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
