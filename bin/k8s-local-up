#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Build + deploy the whole walking skeleton (6 services) onto the local
# OrbStack k8s cluster, no stubs. Shared infra (Postgres-per-service, Kafka)
# as plain manifests in infra/k8s/local-infra/; each service as its own
# Helm release of the generic infra/k8s/gluon chart, parameterized by its
# own environments/local/<name>.values.yaml fragment — see ADR 0007.
#
# Usage:
#   bin/k8s-local-up [service-name ...]   # defaults to all 6
#   USER_SERVICE_IMPL=rust bin/k8s-local-up user-service
#       deploys the Rust user-service (services/user-service-rs, ADR 0028
#       decision 7) under the same release name; scala (the default) switches
#       back. A switch resets the user database's public schema and restarts
#       the user outbox connector so its publication covers the new table.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GLUON_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
NAMESPACE="gluon-local"

USER_SERVICE_IMPL="${USER_SERVICE_IMPL:-scala}"
case "$USER_SERVICE_IMPL" in
  scala | rust) ;;
  *) echo "FAIL: USER_SERVICE_IMPL must be scala or rust, got '$USER_SERVICE_IMPL'" >&2; exit 1 ;;
esac

ALL_SERVICES=(catalog-service cart-service order-service inventory-service payment-service notification-service user-service fulfilment-service)
if [ "$#" -gt 0 ]; then
  SERVICES=("$@")
else
  SERVICES=("${ALL_SERVICES[@]}")
fi

if ! docker info >/dev/null 2>&1; then
  echo "FAIL: docker isn't reachable — is OrbStack running?" >&2
  exit 1
fi
if [ "$(kubectl config current-context 2>/dev/null)" != "orbstack" ]; then
  echo "WARN: kubectl context is not 'orbstack' — switch with" >&2
  echo "      'kubectl config use-context orbstack' or this will deploy" >&2
  echo "      to whatever cluster is actually current." >&2
fi
if [ -z "${GITHUB_TOKEN:-}" ] || [ -z "${GITHUB_ACTOR:-}" ]; then
  echo "WARN: GITHUB_TOKEN / GITHUB_ACTOR not set — each service's sbt build" >&2
  echo "      resolves purerestlib from GitHub Packages and will fail without" >&2
  echo "      a read:packages token. See bin/generate-service's own check." >&2
fi

echo "== Applying namespace + shared local infra =="
kubectl apply -f "$GLUON_DIR/infra/k8s/local-infra/namespace.yaml"
# A Job's pod template is immutable, so re-applying a changed
# debezium-connector-register fails; delete it first. Re-running it is
# harmless (PUT .../config is idempotent), and it re-registers connectors
# lost to an OrbStack restart.
kubectl delete job debezium-connector-register -n "$NAMESPACE" --ignore-not-found
# The schema registry's git store (TD-18), for apicurio-registry's restore
# sidecar - see bin/registry-reload.
"$SCRIPT_DIR/registry-reload" --configmap-only
kubectl apply -f "$GLUON_DIR/infra/k8s/local-infra/"

echo "== Waiting for shared infra to be ready (up to 3m) =="
# Only infra pods exist in the namespace at this point — services below
# haven't been helm-installed yet. The debezium-connector-register Job's
# pod never satisfies condition=Ready (it's meant to terminate, not stay
# ready), so this --all wait is expected to warn once that Job exists —
# harmless, the real pass/fail signal for it is the explicit
# `kubectl wait --for=condition=complete` below.
kubectl wait --for=condition=Ready pod --all -n "$NAMESPACE" --timeout=180s || {
  echo "WARN: not every pod reached Ready in time — check 'kubectl get pods -n $NAMESPACE'" >&2
}

echo "== Waiting for Debezium outbox connectors to register (up to 2m) =="
kubectl wait --for=condition=complete job/debezium-connector-register -n "$NAMESPACE" --timeout=120s || {
  echo "WARN: connector registration didn't complete in time — check 'kubectl logs job/debezium-connector-register -n $NAMESPACE'" >&2
}

# TD-22: inventory-service publishes nothing. The connector is deleted by the
# register Job; prune the retired CronJob/topic from existing clusters too.
echo "== Removing retired inventory-events plumbing =="
kubectl delete cronjob inventory-outbox-cleanup -n "$NAMESPACE" --ignore-not-found
kubectl exec -n "$NAMESPACE" deploy/kafka -- \
  /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 \
  --delete --topic inventory-events --if-exists >/dev/null 2>&1 || true

# The image a release runs now ("" if it isn't deployed), e.g. user-service:latest.
deployed_image() {
  kubectl get "deployment/$1" -n "$NAMESPACE" \
    -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || true
}

for svc in "${SERVICES[@]}"; do
  SERVICE_DIR="$GLUON_DIR/services/$svc"
  VALUES_FILE="$GLUON_DIR/environments/local/$svc.values.yaml"
  IMAGE="$svc"
  if [ "$svc" = user-service ] && [ "$USER_SERVICE_IMPL" = rust ]; then
    SERVICE_DIR="$GLUON_DIR/services/user-service-rs"
    VALUES_FILE="$GLUON_DIR/environments/local/user-service-rs.values.yaml"
    IMAGE="user-service-rs"
  fi
  if [ ! -d "$SERVICE_DIR" ]; then
    echo "FAIL: $SERVICE_DIR doesn't exist" >&2
    exit 1
  fi
  if [ ! -f "$VALUES_FILE" ]; then
    echo "FAIL: $VALUES_FILE doesn't exist" >&2
    exit 1
  fi

  if [ "$IMAGE" = user-service-rs ]; then
    echo "== Building $svc image from services/user-service-rs (docker build) =="
    docker build -t user-service-rs:latest "$SERVICE_DIR"
  else
    echo "== Building $svc image (sbt Docker/publishLocal) =="
    (cd "$SERVICE_DIR" && sbt "Docker/publishLocal")
  fi

  # Switching implementation starts from a clean schema (ADR 0028 decision 5):
  # each keeps its own migration history, and there is no production data.
  SWITCHED=0
  current="$(deployed_image "$svc")"
  if [ "$svc" = user-service ] && [ -n "$current" ] && [ "${current%%:*}" != "$IMAGE" ]; then
    echo "== Switching user-service from ${current%%:*} to $IMAGE: resetting the user schema =="
    kubectl exec -n "$NAMESPACE" deploy/user-postgres -- \
      psql -v ON_ERROR_STOP=1 -q -U user -d user \
      -c 'DROP SCHEMA public CASCADE' -c 'CREATE SCHEMA public' \
      -c 'DROP PUBLICATION IF EXISTS dbz_publication'
    SWITCHED=1
  fi

  echo "== Deploying $svc (helm release) =="
  helm upgrade --install "$svc" "$GLUON_DIR/infra/k8s/gluon" \
    --namespace "$NAMESPACE" \
    -f "$VALUES_FILE"

  # The chart always references the same "<svc>:latest" tag
  # (imagePullPolicy: Never, no registry locally) — so a rebuild that
  # produces a new image under that same tag leaves the Deployment's pod
  # spec textually unchanged, and `helm upgrade` alone won't restart the
  # already-running pod. Force it so the freshly built image is actually
  # picked up.
  echo "== Restarting $svc to pick up the freshly built image =="
  kubectl rollout restart "deployment/$svc" -n "$NAMESPACE"
  kubectl rollout status "deployment/$svc" -n "$NAMESPACE" --timeout=120s

  if [ "$SWITCHED" = 1 ]; then
    # The new service has created outbox_events again; Debezium recreates its
    # publication for it on restart (rehearsed on the sandbox CDC stack:
    # tests/contract tests/integration/test_cdc_stack.py).
    echo "== Restarting the user outbox connector =="
    kubectl exec -n "$NAMESPACE" deploy/kafka-connect -- \
      curl -sf -X POST "http://localhost:8083/connectors/user-outbox-connector/restart?includeTasks=true"
  fi
done

echo "== Done. Check status with: kubectl get pods -n $NAMESPACE =="
