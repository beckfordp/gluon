#!/usr/bin/env python3
# SPDX-License-Identifier: MIT

"""Review a sandbox repo's changes in vim, read-only (docs/sandbox.md).

Opens one vim tab per file, read-only (vim -M): first a summary (git status and
the full diff of changed tracked files), then every new or changed file.
Short to type, so nothing needs pasting into the sandbox.

Usage:
  bin/sandbox-review contract          uncommitted changes in tests/contract
  bin/sandbox-review rust              ... in services/user-service-rs
  bin/sandbox-review contract --ci     run the repo's scripts/ci.sh first
  bin/sandbox-review contract --commit HEAD~2
                                       one commit's changes instead
  bin/sandbox-review contract --list   only list the files

In vim: gt / gT next / previous tab, :qa quit.

Safe to run from the sandbox desktop's terminal, which runs as root while the
repos belong to the sandbox user: git is told to trust the repo for this
command only (a throwaway global config; root's own git config is untouched),
and --ci is refused for another user, because it would leave root-owned files
in the repo.
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Sequence
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from sandbox import GLUON, SANDBOX_REPOS

ALIASES = {"contract": SANDBOX_REPOS[0], "rust": SANDBOX_REPOS[1]}


class ReviewError(Exception):
    """Something the user can act on; printed without a traceback."""


def git(repo: Path, *args: str) -> str:
    """Runs git in `repo`, trusting it even when owned by another user; returns stdout."""
    with tempfile.NamedTemporaryFile("w", prefix="review-gitconfig-", suffix=".ini") as config:
        config.write(f"[safe]\n\tdirectory = {repo}\n")
        config.flush()
        env = {**os.environ, "GIT_CONFIG_GLOBAL": config.name}
        done = subprocess.run(
            ["git", "-C", str(repo), *args], capture_output=True, text=True, check=False, env=env
        )
    if done.returncode != 0:
        raise ReviewError(f"git {' '.join(args)} failed: {done.stderr.strip()}")
    return done.stdout


def owned_by_me(repo: Path) -> bool:
    """Whether this process runs as the repo's owner (the sandbox user)."""
    return repo.stat().st_uid == os.geteuid()


def resolve(name: str) -> Path:
    """An alias (`contract`, `rust`) or a path relative to gluon's root."""
    relative = ALIASES.get(name, Path(name))
    repo = GLUON / relative
    if not (repo / ".git").is_dir():
        known = ", ".join(ALIASES)
        raise ReviewError(f"{relative} is not a sandbox git repo (aliases: {known})")
    return repo


def uncommitted(repo: Path) -> tuple[str, list[str]]:
    """The summary text and the files to open for uncommitted changes."""
    status = git(repo, "status", "--short")
    diff = git(repo, "diff", "HEAD")
    untracked = git(repo, "ls-files", "--others", "--exclude-standard").splitlines()
    changed = git(repo, "diff", "HEAD", "--name-only", "--diff-filter=d").splitlines()
    summary = f"# git status --short\n{status}\n# git diff HEAD\n{diff}"
    return summary, sorted(set(untracked) | set(changed))


def one_commit(repo: Path, revision: str) -> tuple[str, list[str]]:
    """The summary text and the files to open for one commit."""
    show = git(repo, "show", "--stat", "--patch", "--notes", revision)
    files = git(repo, "show", "--name-only", "--diff-filter=d", "--format=", revision)
    return show, [name for name in files.splitlines() if (repo / name).is_file()]


def main(argv: Sequence[str]) -> int:
    """Runs `review`, printing a ReviewError as a plain message."""
    try:
        return review(argv)
    except ReviewError as error:
        print(f"sandbox-review: {error}", file=sys.stderr)
        return 1


def review(argv: Sequence[str]) -> int:
    """Collects the changes and opens them (or lists them)."""
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("repo", help="contract, rust, or a path relative to gluon")
    parser.add_argument("--ci", action="store_true", help="run the repo's scripts/ci.sh first")
    parser.add_argument("--commit", metavar="REV", help="review this commit instead")
    parser.add_argument("--list", action="store_true", help="list the files, don't open vim")
    args = parser.parse_args(argv)
    repo = resolve(args.repo)

    if args.ci and not owned_by_me(repo):
        raise ReviewError(
            "--ci refused: this terminal runs as a different user from the repo's owner, "
            "and CI would leave files the owner can't change. Run CI as the sandbox user, "
            "or review without --ci."
        )
    if args.ci and (repo / "scripts" / "ci.sh").is_file():
        print(f"== {repo.relative_to(GLUON)}: scripts/ci.sh")
        if subprocess.run([str(repo / "scripts" / "ci.sh")], cwd=repo, check=False).returncode:
            print("CI failed; opening the review anyway.\n")

    if args.commit:
        summary, files = one_commit(repo, args.commit)
    else:
        summary, files = uncommitted(repo)
    if not files and "\ndiff --git" not in "\n" + summary:
        print(f"{repo.relative_to(GLUON)}: nothing to review")
        return 0

    if args.list:
        for name in files:
            print(name)
        return 0

    if shutil.which("vim") is None:
        raise ReviewError("vim is not on the PATH; bin/sandbox-setup installs it")
    label = (args.commit or "uncommitted").replace("/", "_")
    handle, name = tempfile.mkstemp(prefix=f"review-{repo.name}-{label}-", suffix=".diff")
    with os.fdopen(handle, "w", encoding="utf-8") as summary_out:
        summary_out.write(summary)
    print(f"Opening {len(files) + 1} tabs read-only. gt / gT switch tabs, :qa quits.")
    os.chdir(repo)
    os.execvp("vim", ["vim", "-M", "--cmd", "set tabpagemax=100", "-p", name, *files])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
