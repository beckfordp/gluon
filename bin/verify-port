#!/usr/bin/env python3
# SPDX-License-Identifier: MIT

"""Verify a service's Rust port against its contract (RPN-6).

The contract is the same wherever this runs: the sandbox, the laptop, the
Linux test bed. Its criteria are data, one file per service:
docs/ports/<service>.criteria.json, each naming the steps whose outcome decides
it (`contract:probe` for one contract group). The steps the criteria need run
one at a time, each outcome printed as it finishes, then every criterion MET /
NOT MET / not run. Logs go to a run directory, printed at the start.

Deployment (the switch, acceptance in the cluster, Tempo, Kibana, dashboards)
isn't the contract: it is checked on the laptop, by hand until RPN-L1
(plans/private/ports/<service>-verification.md, private).

Steps (those a service has):
  harness-ci  tests/contract scripts/ci.sh (unit + integration tests, lint, types)
  rust-ci     the Rust port's scripts/ci.sh (fmt, clippy, tests, coverage)
  build       the Rust service (and user-service's probe and AsyncAPI HTML)
  contract    every contract group against the Rust build, in one session
  cluster     the harness's cluster mode inside gluon-kube, the simulated gluon-local
              (bin/gluon-kube-contract; ADR 0030, plans/gluon-kube/plan.md GK-7.4)
  tracks      the track scripts CI can't replace (--skip-ci: CI ran above)

Exit: 0 when every criterion that ran is MET and every step passed; 1 on any
NOT MET or failed step; 2 on bad arguments or criteria.

Usage:
  bin/verify-port user-service                   everything (~20 min)
  bin/verify-port user-service --quick           without the track scripts
  bin/verify-port user-service --only contract tracks
  bin/verify-port notification-service
  bin/verify-port cart-service --only build contract \
      --acceptance tests/acceptance/target/acceptance-results.json
  bin/verify-port cart-service --only build contract --group docs --expect-red "answered 404"

--group: the contract step runs one group's checks (`checks/test_<short>_[<topic>_]<group>.py`).
--expect-red: the RED half of a port (Stage A): PASS only when the skeleton builds and
every check run is red, each for a reason the regex finds in pytest's summary.

--acceptance: the Playwright JSON report of an acceptance run against this port
(bin/run-acceptance writes it); its scenarios' `@<SVC>-F<n>` tags count towards the
behaviour tally beside the checks. Only a run against the port: one against Scala
would meet the port's rows for it.

Run from the sandbox desktop's root terminal too: it re-runs itself as the
repos' owner, as every verify script does.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from collections import Counter
from collections.abc import Callable
from dataclasses import dataclass, field
from pathlib import Path

GLUON = Path(__file__).resolve().parent.parent
CONTRACT = GLUON / "tests" / "contract"
CRITERIA_DIR = GLUON / "docs" / "ports"
OWNER_BIN = Path("/home/claude/.local/bin")
LOGS_ROOT = Path("/tmp")

STEP_ORDER = ["harness-ci", "rust-ci", "build", "contract", "cluster", "tracks"]

CLUSTER_RUNS_HERE = sys.platform == "linux"
"""gluon-kube needs Linux (network namespaces, bwrap); the laptop runs the real cluster."""
CLUSTER_ELSEWHERE = "sandbox only (gluon-kube needs Linux); its criterion is not run"


@dataclass(frozen=True)
class Service:
    """What verifying one Rust port runs."""

    name: str
    rust: Path
    packages: list[str]
    probe: bool = False
    """Its contract run passes the events probe (`--probe-cmd`)."""
    asyncapi_html: bool = False
    """Its build renders the AsyncAPI HTML (`scripts/asyncapi-html.sh`)."""
    cluster: bool = False
    """It has a cluster mode, run in gluon-kube (bin/gluon-kube-contract)."""
    track_scripts: list[tuple[Path, str]] = field(default_factory=list)
    """The track scripts CI can't replace; the rest were retired into CI and the
    harness (TECHNICAL_DEBT.md TD-46, plans/private/sandbox.md "Track scripts")."""

    @property
    def steps(self) -> list[str]:
        return [
            s
            for s in STEP_ORDER
            if (s != "tracks" or self.track_scripts) and (s != "cluster" or self.cluster)
        ]


USER_RS = GLUON / "services" / "user-service-rs"
SERVICES = {
    "user-service": Service(
        "user-service",
        USER_RS,
        ["user-service", "events-probe"],
        probe=True,
        asyncapi_html=True,
        cluster=True,
        track_scripts=[(USER_RS, "verify-rust-ci"), (CONTRACT, "verify-cluster-mode")],
    ),
    "notification-service": Service(
        "notification-service",
        GLUON / "services" / "notification-service-rs",
        ["notification-service"],
    ),
}
# The all-Rust ports (Stage A), generated from tools/rust-service-template; their docs are
# built into the binary, so the build is its binary alone.
for _name in ("cart", "catalog", "inventory", "payment", "order", "fulfilment"):
    _service = f"{_name}-service"
    SERVICES[_service] = Service(_service, GLUON / "services" / f"{_service}-rs", [_service])

KINDS = ("functional", "docs", "wire")
"""A behaviour's kinds (tests/contract docs/behaviours.md, "Kinds of behaviour")."""
KINDS_FOOTER = 'kinds of behaviour: tests/contract docs/behaviours.md, "Kinds of behaviour"'



class CriteriaError(Exception):
    """A criteria file that can't be used."""


@dataclass(frozen=True)
class Criterion:
    id: str
    description: str
    needs: list[str]
    kind: str = ""
    """The kind of behaviour it judges (KINDS), if one."""
    rows: str = ""
    """The catalogue rows it covers, e.g. `CART-F1–F12`."""


@dataclass(frozen=True)
class Criteria:
    service: str
    criteria: list[Criterion]
    guide: str = ""


def load_criteria(path: Path, service: Service) -> Criteria:
    """Reads and checks `path`: its service, unique ids, each needing known steps."""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        raise CriteriaError(f"{path}: {error}") from error
    if data.get("service") != service.name:
        raise CriteriaError(f"{path}: service {data.get('service')!r}, not {service.name!r}")
    criteria, seen = [], set()
    for raw in data.get("criteria", []):
        try:
            criterion = Criterion(
                raw["id"],
                raw["description"],
                list(raw["needs"]),
                raw.get("kind", ""),
                raw.get("rows", ""),
            )
        except (KeyError, TypeError) as error:
            raise CriteriaError(f"{path}: a criterion lacks {error}") from error
        if criterion.kind and criterion.kind not in KINDS:
            raise CriteriaError(f"{path}: {criterion.id}: unknown kind {criterion.kind!r}")
        if not criterion.needs:
            raise CriteriaError(f"{path}: {criterion.id}: needs no step")
        for need in criterion.needs:
            step, _, group = need.partition(":")
            if step not in service.steps or (group and step != "contract"):
                raise CriteriaError(f"{path}: {criterion.id}: {service.name} has no step {need!r}")
        if criterion.id in seen:
            raise CriteriaError(f"{path}: duplicate id {criterion.id}")
        seen.add(criterion.id)
        criteria.append(criterion)
    if not criteria:
        raise CriteriaError(f"{path}: no criteria")
    return Criteria(service.name, criteria, data.get("guide", ""))


def is_built(service: Service) -> bool:
    """Everything the build step makes is there: the binaries, and the AsyncAPI HTML the
    docs group serves (TD-60: binaries alone let `--only contract` fail docs falsely)."""
    binaries = all((service.rust / "target/debug" / p).exists() for p in service.packages)
    html = service.rust / "target/asyncapi-docs/index.html"
    return binaries and (not service.asyncapi_html or html.is_file())


def steps_for(
    criteria: Criteria, only: list[str] | None, quick: bool, built: bool
) -> list[str]:
    """The steps to run, in order: `only`, or every step the criteria need (not
    `tracks` when quick); `build` before `contract`, unless `only` asks for
    `contract` and the build is there (`built`)."""
    if only:
        wanted = set(only)
        if "contract" in wanted and not built:
            wanted.add("build")
    else:
        wanted = {need.partition(":")[0] for c in criteria.criteria for need in c.needs}
        if "contract" in wanted:
            wanted.add("build")
        if quick:
            wanted.discard("tracks")
        if "cluster" in wanted and not CLUSTER_RUNS_HERE:
            wanted.discard("cluster")
            print(f"skip cluster: {CLUSTER_ELSEWHERE}\n", flush=True)
    return [s for s in STEP_ORDER if s in wanted]


def evaluate(criteria: Criteria, steps: dict[str, "Step"]) -> list[tuple[Criterion, str]]:
    """Each criterion's state: MET / NOT MET, or not run when none of its steps ran."""
    states = []
    for criterion in criteria.criteria:
        outcomes = []
        for need in criterion.needs:
            name, _, group = need.partition(":")
            if name in steps:
                step = steps[name]
                outcomes.append(step.groups.get(group, False) if group else step.ok)
        state = "not run" if not outcomes else ("MET" if all(outcomes) else "NOT MET")
        states.append((criterion, state))
    return states


@dataclass(frozen=True)
class Outcome:
    """One check's result in a contract run, with pytest's reason for a red one."""

    module: str
    test: str
    result: str
    """PASSED, FAILED or ERROR."""
    reason: str = ""


@dataclass
class Step:
    """One step's outcome."""

    name: str
    ok: bool
    summary: str
    detail: list[str] = field(default_factory=list)
    groups: dict[str, bool] = field(default_factory=dict)
    """For the contract step: each group's outcome (all its checks green)."""
    checks: list[Outcome] = field(default_factory=list)
    """For the contract step: every check's outcome (`--expect-red` judges them)."""
    rows: str = ""
    """For the contract step: catalogue rows met per kind, printed apart from the check
    counts (a row is not a check: Stage A P0.1)."""


def as_owner(service: Service) -> None:
    """Re-executes as the repos' owner when run as root (never writes as root)."""
    owner = service.rust.stat().st_uid
    if os.getuid() == owner:
        return
    if os.getuid() != 0:
        sys.exit(f"FAIL run as the owner of {service.rust}")
    import pwd

    entry = pwd.getpwuid(owner)
    print(f"== re-running as {entry.pw_name} (the repos' owner) ==", flush=True)
    path = f"{OWNER_BIN}:{entry.pw_dir}/.cargo/bin:{os.environ.get('PATH', '')}"
    os.execvp(
        "runuser",
        [
            "runuser",
            "-u",
            entry.pw_name,
            "--",
            "env",
            f"HOME={entry.pw_dir}",
            f"PATH={path}",
            "LANG=C.UTF-8",
            sys.executable,
            __file__,
            *sys.argv[1:],
        ],
    )


def run(log: Path, argv: list[str], cwd: Path, timeout: int = 3600) -> tuple[int, str]:
    """Runs a command, output to `log`; (exit code, output)."""
    started = time.monotonic()
    with log.open("w") as out:
        try:
            done = subprocess.run(
                argv, cwd=cwd, stdout=out, stderr=subprocess.STDOUT, timeout=timeout, check=False
            )
            code = done.returncode
        except subprocess.TimeoutExpired:
            code = 124
    text = log.read_text(errors="replace")
    print(f"     ({time.monotonic() - started:.0f} s, log {log})", flush=True)
    return code, text


def last_line(text: str) -> str:
    lines = [line for line in text.splitlines() if line.strip()]
    return lines[-1] if lines else "(no output)"


def step_ci(logs: Path, name: str, repo: Path) -> Step:
    code, text = run(logs / f"{name}.log", [str(repo / "scripts" / "ci.sh")], repo)
    if name == "harness-ci":
        found = re.findall(r"(\d+ passed).*?\n|Total coverage: ([\d.]+%)", text)
        passed = next((p for p, _ in found if p), "?")
        coverage = next((c for _, c in found if c), "?")
        summary = f"{passed}, coverage {coverage}"
    else:
        total = next((line for line in text.splitlines() if line.startswith("TOTAL")), "")
        summary = f"line coverage {total.split()[-4] if total else '?'}"
        if "SKIP cargo-audit" in text:
            summary += "; cargo-audit SKIP (its database is on GitHub)"
    return Step(name, code == 0, summary, [] if code == 0 else text.splitlines()[-10:])


def step_build(logs: Path, service: Service) -> Step:
    packages = [arg for package in service.packages for arg in ("-p", package)]
    argv = ["cargo", "build", "-q", "--locked", *packages]
    code, text = run(logs / "build.log", argv, service.rust)
    if code != 0:
        return Step("build", False, "cargo build failed", text.splitlines()[-10:])
    built = ", ".join(service.packages)
    if not service.asyncapi_html:
        return Step("build", True, built)
    script = str(service.rust / "scripts" / "asyncapi-html.sh")
    code, text = run(logs / "asyncapi-html.log", [script], service.rust)
    return Step(
        "build",
        code == 0,
        f"{built}, AsyncAPI HTML" if code == 0 else "asyncapi-html.sh failed",
        [] if code == 0 else text.splitlines()[-10:],
    )


def group_name(module: str, service: Service) -> str:
    """`test_cart_functional` → `functional`: the group, without the service its module is
    named for (`test_probe`, named for none, is `probe`)."""
    short = service.name.removesuffix("-service")
    return module.removeprefix("test_").removeprefix(f"{short}_")


def group_modules(service: Service, group: str, modules: list[str]) -> list[str]:
    """The modules among `modules` (names, `test_…`) whose group is `group`, or ends with
    it: `--group functional` runs `test_notification_rest_functional` too (a module of
    one kind per topic, tests/contract docs/behaviours.md "Kinds of behaviour")."""
    return [
        m
        for m in modules
        if (name := group_name(m, service)) == group or name.endswith(f"_{group}")
    ]


def parse_outcomes(text: str) -> list[Outcome]:
    """Every check's outcome in pytest `-rA` output; a red one's reason is its short-summary
    message (`FAILED checks/… - <reason>`)."""
    found = re.findall(
        r"^(PASSED|FAILED|ERROR) checks/(test_\w+)\.py::(\S+)(?: - (.*))?$", text, re.MULTILINE
    )
    return [Outcome(module, test, result, reason) for result, module, test, reason in found]


def contract_summary(outcomes: list[Outcome], service: Service) -> str:
    """`N/M checks green — <group> x/y, …`, groups in name order."""
    per_group: Counter[str] = Counter()
    green: Counter[str] = Counter()
    for outcome in outcomes:
        group = group_name(outcome.module, service)
        per_group[group] += 1
        green[group] += outcome.result == "PASSED"
    groups = ", ".join(f"{g} {green[g]}/{n}" for g, n in sorted(per_group.items()))
    return f"{sum(green.values())}/{len(outcomes)} checks green — {groups}"


def expect_red(outcomes: list[Outcome], pattern: str) -> tuple[bool, list[str]]:
    """Whether every check is red for the reason `pattern` (a regex) finds, and a line for
    each that isn't: a check written before the code it judges fails for the reason it
    should, not for a broken harness (Stage A, ATDD)."""
    if not outcomes:
        return False, ["no checks ran"]
    found = re.compile(pattern)
    lines = []
    for o in outcomes:
        if o.result == "PASSED":
            lines.append(f"{o.module}::{o.test} is green")
        elif not found.search(o.reason):
            lines.append(f"{o.module}::{o.test} red for another reason: {o.reason or '(none)'}")
    return not lines, lines


def step_contract(
    logs: Path, service: Service, acceptance: Path | None, group: str | None = None
) -> Step:
    paths = ["checks"]
    if group:
        names = sorted(p.stem for p in (CONTRACT / "checks").glob("test_*.py"))
        paths = [f"checks/{m}.py" for m in group_modules(service, group, names)]
        if not paths:
            return Step("contract", False, f"no checks in group {group!r}")
    # pytest drops a short-summary reason that doesn't fit the terminal; a long check name
    # leaves no room in 80 columns, and --expect-red reads the reason (all-Rust A, cart).
    argv = [
        "env",
        "COLUMNS=10000",
        "uv",
        "run",
        "--no-sync",
        "pytest",
        *paths,
        "--service",
        service.name,
        "-p",
        "no:cacheprovider",
        "-rA",
        "--tb=line",
        "-q",
        "--target-cmd",
        str(service.rust / "target/debug" / service.name),
        "--target-cwd",
        str(service.rust),
        "--target-name",
        f"{service.name}-rs",
    ]
    if service.probe:
        argv += ["--probe-cmd", str(service.rust / "target/debug/events-probe")]
    code, text = run(logs / "contract.log", argv, CONTRACT)
    outcomes = parse_outcomes(text)
    failed = [f"{o.module}::{o.test}" for o in outcomes if o.result != "PASSED"]
    ok = code == 0 and bool(outcomes) and not failed
    by_group: dict[str, bool] = {}
    for o in outcomes:
        name = group_name(o.module, service)
        by_group[name] = by_group.get(name, True) and o.result == "PASSED"
    summary = contract_summary(outcomes, service)
    rows = behaviour_tally(logs / "contract.log", service, acceptance)
    return Step("contract", ok, summary, failed, by_group, outcomes, rows)


def behaviour_tally(log: Path, service: Service, acceptance: Path | None) -> str:
    """Behaviours met per layer (tests/contract docs/behaviours.md, all-Rust prep P5),
    counting the acceptance run's scenarios when given its report (P5b); empty for a
    service the catalogue doesn't list."""
    argv = ["uv", "run", "--no-sync", "python", "-m", "gluon_contract.behaviours", "tally"]
    argv += [service.name, str(log), *([str(acceptance)] if acceptance else [])]
    done = subprocess.run(argv, cwd=CONTRACT, capture_output=True, text=True, check=False)
    if done.returncode != 0:
        return f"tally failed: {done.stderr.strip()[-200:]}"
    lines = done.stdout.strip().splitlines()
    if lines and acceptance:
        lines.insert(1, f"acceptance counted: {acceptance} (run {acceptance_started(acceptance)})")
    return "; ".join(lines)


def acceptance_started(report: Path) -> str:
    """When the reported acceptance run started, for the reviewer to judge it current."""
    try:
        return json.loads(report.read_text(encoding="utf-8"))["stats"]["startTime"]
    except (OSError, ValueError, KeyError, TypeError):
        return "start unknown"


def step_cluster(logs: Path, service: Service) -> Step:
    """The harness's cluster mode against the port deployed by gluon-kube (`up`, its
    chart and values file), run inside the simulated cluster: green, with the topic check
    among the passes."""
    code, text = run(
        logs / "cluster.log", [str(GLUON / "bin" / "gluon-kube-contract"), service.name], GLUON
    )
    failed = re.findall(r"^(?:FAILED|ERROR) (checks/\S+)", text, re.MULTILINE)
    summary_line = next(
        (line for line in reversed(text.splitlines()) if re.search(r"\d+ passed", line)), ""
    )
    topic = "PASSED checks/test_user_cdc.py::test_a_signup_reaches_user_events_in_its_trace"
    ok = code == 0 and not failed and topic in text
    summary = summary_line.strip() or last_line(text)
    if code == 0 and topic not in text:
        summary += "; the topic check didn't pass"
    return Step("cluster", ok, summary, failed or ([] if ok else text.splitlines()[-10:]))


def step_tracks(logs: Path, service: Service) -> Step:
    failed, passed = [], 0
    for repo, script in service.track_scripts:
        args = [str(repo / "scripts" / f"{script}.sh")]
        if script != "verify-rust-ci":
            args.append("--skip-ci")
        print(f"     {repo.name}/scripts/{script}.sh", flush=True)
        code, text = run(logs / f"{repo.name}-{script}.log", args, repo)
        line = last_line(text)
        print(f"     {'ok  ' if code == 0 else 'FAIL'} {line}", flush=True)
        if code == 0:
            passed += 1
        else:
            failed.append(f"{repo.name}/{script}: {line}")
    return Step(
        "tracks", not failed, f"{passed} of {passed + len(failed)} track scripts pass", failed
    )


def report_expect_red(steps: dict[str, Step], pattern: str, logs: Path) -> int:
    """`--expect-red`'s verdict: every step before the contract passed (the skeleton
    builds), and every check is red for `pattern`."""
    broken = [s.name for s in steps.values() if s.name != "contract" and not s.ok]
    ok, lines = expect_red(steps["contract"].checks, pattern)
    print(f"\n== expect red: {pattern!r} ==")
    for line in lines[:40]:
        print(f"  {line}")
    print(f"({KINDS_FOOTER})\n")
    if broken or not ok:
        reasons = [f"failed: {', '.join(broken)}"] if broken else []
        reasons += [f"expected red, {len(lines)} not"] if not ok else []
        print(f"FAIL: {'; '.join(reasons)} (logs in {logs})")
        return 1
    count = len(steps["contract"].checks)
    print(f"PASS: every check red for {pattern!r} ({count} checks; logs in {logs})")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("service", choices=sorted(SERVICES))
    parser.add_argument("--quick", action="store_true", help="skip the track scripts")
    parser.add_argument("--only", nargs="+", choices=STEP_ORDER)
    parser.add_argument(
        "--group", metavar="NAME", help="the contract step runs only this group's checks"
    )
    parser.add_argument(
        "--expect-red",
        metavar="PATTERN",
        help="with --only … contract: PASS only when every check run is red, each for a "
        "reason this regex finds (a check seen red before the port)",
    )
    parser.add_argument(
        "--acceptance",
        type=Path,
        metavar="REPORT",
        help="an acceptance run's Playwright JSON report: count its scenarios' behaviour tags",
    )
    args = parser.parse_args()
    service = SERVICES[args.service]
    acceptance = args.acceptance.resolve() if args.acceptance else None
    if acceptance and not acceptance.is_file():
        print(f"verify-port: no acceptance report {acceptance}", file=sys.stderr)
        return 2
    try:
        criteria = load_criteria(CRITERIA_DIR / f"{service.name}.criteria.json", service)
    except CriteriaError as error:
        print(f"verify-port: {error}", file=sys.stderr)
        return 2
    if args.expect_red is not None and "contract" not in (args.only or []):
        print("verify-port: --expect-red needs --only … contract", file=sys.stderr)
        return 2
    if not service.rust.is_dir():
        print(
            f"verify-port: no Rust port at {service.rust} yet (generate it from "
            "tools/rust-service-template)",
            file=sys.stderr,
        )
        return 2
    unknown = [s for s in args.only or [] if s not in service.steps]
    if unknown:
        print(f"verify-port: {service.name} has no step {', '.join(unknown)}", file=sys.stderr)
        return 2
    if "cluster" in (args.only or []) and not CLUSTER_RUNS_HERE:
        print(f"verify-port: {CLUSTER_ELSEWHERE}", file=sys.stderr)
        return 2
    as_owner(service)
    os.environ["PATH"] = f"{OWNER_BIN}:{Path.home() / '.cargo/bin'}:{os.environ.get('PATH', '')}"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    logs = Path(tempfile.mkdtemp(prefix=f"verify-port-{service.name}-{stamp}-", dir=LOGS_ROOT))
    print(f"{service.name} port verification — logs in {logs}\n", flush=True)
    wanted = steps_for(criteria, args.only, args.quick, is_built(service))
    actions: dict[str, Callable[[], Step]] = {
        "harness-ci": lambda: step_ci(logs, "harness-ci", CONTRACT),
        "rust-ci": lambda: step_ci(logs, "rust-ci", service.rust),
        "build": lambda: step_build(logs, service),
        "contract": lambda: step_contract(logs, service, acceptance, args.group),
        "cluster": lambda: step_cluster(logs, service),
        "tracks": lambda: step_tracks(logs, service),
    }
    steps: dict[str, Step] = {}
    for number, name in enumerate(wanted, 1):
        print(f"== {number}. {name} ==", flush=True)
        step = actions[name]()
        steps[name] = step
        print(f"{'ok  ' if step.ok else 'FAIL'} {name}: {step.summary}", flush=True)
        for line in step.detail[:20]:
            print(f"       {line}", flush=True)
    if args.expect_red is not None:
        return report_expect_red(steps, args.expect_red, logs)
    print(f"\n== {service.name} contract criteria ==")
    states = evaluate(criteria, steps)
    width = max(len(c.id) for c in criteria.criteria)
    for criterion, state in states:
        scope = f"[{criterion.kind} {criterion.rows}] " if criterion.kind else ""
        print(f"{state:<8} {criterion.id:<{width}} {scope}{criterion.description}")
    if criteria.guide:
        print(f"({criteria.guide})")
    if "contract" in steps and steps["contract"].rows:
        print(f"rows met: {steps['contract'].rows}")
    print(f"({KINDS_FOOTER})")
    unmet = [c.id for c, state in states if state == "NOT MET"]
    failed = [s.name for s in steps.values() if not s.ok]
    print()
    if unmet or failed:
        reasons = [f"NOT MET: {', '.join(unmet)}"] if unmet else []
        reasons += [f"failed: {', '.join(failed)}"] if failed else []
        print(f"FAIL: {'; '.join(reasons)} (logs in {logs})")
        return 1
    print(f"PASS: every criterion run is MET ({len(steps)} steps; logs in {logs})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
