# --- Reporting --------------------------------------------------------------


@dataclass(frozen=True, slots=True)
class Result:
    """One line of the report: a step, its outcome, and a detail."""

    step: str
    status: str  # OK, INSTALLED, MISSING, INFO
    detail: str


def run(argv: Sequence[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> str:
    """Runs a command, returning stdout; raises with stderr on failure."""
    done = subprocess.run(
        list(argv), cwd=cwd, env=env, capture_output=True, text=True, check=False, timeout=900
    )
    if done.returncode != 0:
        raise RuntimeError(f"{' '.join(argv)} failed ({done.returncode}): {done.stderr.strip()}")
    return done.stdout


def first_line(argv: Sequence[str]) -> str:
    """The first line of a command's output, or '' if it can't run."""
    try:
        return run(argv).splitlines()[0].strip()
    except (OSError, RuntimeError, IndexError, subprocess.TimeoutExpired):
        return ""


def output(argv: Sequence[str]) -> str:
    """A command's output, or '' if it can't run."""
    try:
        return run(argv)
    except (OSError, RuntimeError, subprocess.TimeoutExpired):
        return ""


def bin_dir() -> Path:
    """Where wrappers and links go: SANDBOX_BIN, else the first writable ~/.local/bin on PATH."""
    if explicit := os.environ.get("SANDBOX_BIN"):
        return Path(explicit)
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        path = Path(entry)
        if path.name == "bin" and path.parent.name == ".local" and os.access(path, os.W_OK):
            return path
    return HOME / ".local" / "bin"


# --- Steps ------------------------------------------------------------------


def step_network(_install: bool) -> list[Result]:
    """The package sources installs need (report only)."""
    results = []
    for name, url in PACKAGE_SOURCES.items():
        try:
            # The Ubuntu archive answers 403 to urllib's default User-Agent.
            request = urllib.request.Request(
                url, method="HEAD", headers={"User-Agent": "gluon-sandbox-setup"}
            )
            with urllib.request.urlopen(request, timeout=15) as response:
                status = response.status
        except OSError as error:
            results.append(Result("network", "MISSING", f"{name} unreachable: {error}"))
            continue
        results.append(Result("network", "OK", f"{name} ({status})"))
    return results


def step_image(_install: bool) -> list[Result]:
    """What the sandbox image provides; verified, never installed here."""
    results = []
    for tool in IMAGE_TOOLS:
        found = shutil.which(tool)
        results.append(
            Result("image", "OK", f"{tool}: {found}")
            if found
            else Result("image", "MISSING", f"{tool} not on PATH (image-provided; can't install)")
        )
    python = first_line(["uv", "python", "find", PYTHON_VERSION])
    results.append(
        Result("image", "OK", f"Python {PYTHON_VERSION}: {python}")
        if python
        else Result(
            "image",
            "MISSING",
            f"uv can't find Python {PYTHON_VERSION} (expected under /opt/uv-python)",
        )
    )
    results.extend(arch_results())
    results.extend(isolation())
    pg_ctl = shutil.which("pg_ctl")
    if pg_ctl is None:
        results.append(Result("image", "MISSING", "PostgreSQL binaries: pg_ctl not on PATH"))
        return results
    pg_bin = Path(pg_ctl).resolve().parent
    missing = [tool for tool in PG_TOOLS if not (pg_bin / tool).is_file()]
    version = first_line([str(pg_bin / "postgres"), "--version"])
    if missing or " 16." not in version:
        results.append(
            Result("image", "MISSING", f"PostgreSQL 16 in {pg_bin}: lacks {missing}, {version!r}")
        )
    else:
        results.append(Result("image", "OK", f"{version} in {pg_bin}"))
    return results


def isolation() -> list[Result]:
    """gluon-kube's isolation tools, and an unprivileged user namespace actually created."""
    results = []
    for tool in ISOLATION_TOOLS:
        found = shutil.which(tool)
        results.append(
            Result("image", "OK", f"{tool}: {found}")
            if found
            else Result("image", "MISSING", f"{tool} not on PATH (image-provided; can't install)")
        )
    try:
        created = subprocess.run(
            ["unshare", "-Ur", "true"], check=False, capture_output=True, timeout=10
        )
        works = created.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        works = False
    results.append(
        Result("image", "OK", "user namespaces: unprivileged `unshare -Ur` works")
        if works
        else Result(
            "image", "MISSING", "user namespaces: `unshare -Ur` fails (gluon-kube needs it)"
        )
    )
    return results


def arch_results() -> list[Result]:
    """Nothing when setup knows this machine's downloads; else why not."""
    if MACHINE in ARCHES:
        return []
    known = ", ".join(ARCHES)
    return [Result("image", "MISSING", f"machine {MACHINE}: setup knows {known} only")]


def toolchain_mismatch(verbose: str) -> str | None:
    """None when `rustc -vV`'s host is this machine's; else what is wrong (a cache volume
    made on another machine)."""
    host = re.search(r"^host: (\S+)$", verbose, re.MULTILINE)
    if host is None:
        return "rustc doesn't run on this machine"
    if host[1] != ARCH.rust:
        return f"the toolchain is {host[1]}'s, this machine is {ARCH.rust}"
    return None


def step_rust(install: bool) -> list[Result]:
    """Rust via rustup (pinned toolchain, components, cargo tools), linked onto the PATH."""
    cargo_bin = CARGO_HOME / "bin"
    present = (cargo_bin / "cargo").is_file() and all(
        (cargo_bin / tool).is_file() for tool in ("rustfmt", "cargo-clippy")
    )
    status = "OK"
    if not present:
        if not install:
            return [
                Result("rust", "MISSING", "rustup toolchain not installed (run without --check)")
            ]
        with tempfile.TemporaryDirectory() as scratch:
            init = Path(scratch) / "rustup-init"
            urllib.request.urlretrieve(RUSTUP_INIT_URL, init)
            init.chmod(0o755)
            components = [arg for c in RUST_COMPONENTS for arg in ("-c", c)]
            run(
                [
                    str(init),
                    "-y",
                    "--profile",
                    "minimal",
                    "--default-toolchain",
                    RUST_TOOLCHAIN,
                    "--no-modify-path",
                    *components,
                ]
            )
        status = "INSTALLED"
    mismatch = toolchain_mismatch(output([str(cargo_bin / "rustc"), "-vV"]))
    if mismatch is not None:
        return [Result("rust", "MISSING", f"{mismatch} (remove {CARGO_HOME} and ~/.rustup)")]
    rustup = str(cargo_bin / "rustup")
    toolchain = ["--toolchain", RUST_TOOLCHAIN]
    if RUST_TOOLCHAIN not in run([rustup, "toolchain", "list"]):
        if not install:
            return [Result("rust", "MISSING", f"toolchain {RUST_TOOLCHAIN} not installed")]
        run([rustup, "toolchain", "install", RUST_TOOLCHAIN, "--profile", "minimal"])
        status = "INSTALLED"
    installed = run([rustup, "component", "list", "--installed", *toolchain])
    missing = [c for c in RUST_COMPONENTS if c.removesuffix("-preview") not in installed]
    if missing:
        if not install:
            return [Result("rust", "MISSING", f"rustup components missing: {', '.join(missing)}")]
        run([rustup, "component", "add", *missing, *toolchain])
        status = "INSTALLED"
    for tool, version in CARGO_TOOLS.items():
        subcommand = tool.removeprefix("cargo-")
        on_path = first_line([tool, subcommand, "--version"])
        if version not in on_path and version not in first_line(
            [str(cargo_bin / tool), subcommand, "--version"]
        ):
            if not install:
                return [Result("rust", "MISSING", f"{tool} {version} not installed")]
            run([str(cargo_bin / "cargo"), "install", tool, "--version", version, "--locked"])
            status = "INSTALLED"
    if install:
        link_all(cargo_bin, bin_dir())
    elif not all(
        (bin_dir() / tool).exists() for tool in ("cargo", "rustc", "rustfmt", "cargo-clippy")
    ):
        return [Result("rust", "MISSING", f"toolchain installed but not linked into {bin_dir()}")]
    version = first_line([str(cargo_bin / "rustc"), "--version"])
    tools = ", ".join(f"{tool} {v}" for tool, v in CARGO_TOOLS.items())
    return [Result("rust", status, f"{version}; {tools}; linked into {bin_dir()}")]


def provided_node() -> str | None:
    """A Node >= 24.11 on the PATH that isn't ours (the image's, a mirror's), or None."""
    found = shutil.which("node")
    match = re.match(r"v(\d+)\.(\d+)", first_line([found, "--version"]) if found else "")
    if found is None or match is None or (int(match[1]), int(match[2])) < (24, 11):
        return None
    return None if Path(found).resolve().is_relative_to(NODE_ROOT) else found


def step_node(install: bool) -> list[Result]:
    """Node 24 from npm's node-linux-<arch> into ~/.local, linked onto the PATH as node24."""
    link = bin_dir() / "node24"
    provided = provided_node()
    if provided is not None:
        if install:
            link.parent.mkdir(parents=True, exist_ok=True)
            link.unlink(missing_ok=True)
            link.symlink_to(provided)
        elif not link.exists() or link.resolve() != Path(provided).resolve():
            return [Result("node", "MISSING", f"{provided} is Node >= 24 but {link} isn't it")]
        return [Result("node", "OK", f"{first_line([provided, '--version'])} provided, as {link}")]
    node = NODE_ROOT / "bin" / "node"
    status = "OK"
    if first_line([str(node), "--version"]) != f"v{NODE_VERSION}":
        if not install:
            return [
                Result(
                    "node", "MISSING", f"Node {NODE_VERSION} not installed (run without --check)"
                )
            ]
        with tempfile.TemporaryDirectory() as scratch:
            run(["npm", "pack", f"{NODE_PACKAGE}@{NODE_VERSION}", "--silent"], cwd=Path(scratch))
            tarball = Path(scratch) / f"{NODE_PACKAGE}-{NODE_VERSION}.tgz"
            run(["tar", "xzf", str(tarball), "-C", scratch])
            shutil.rmtree(NODE_ROOT, ignore_errors=True)
            shutil.copytree(Path(scratch) / "package", NODE_ROOT, symlinks=True)
        status = "INSTALLED"
    if install:
        link.parent.mkdir(parents=True, exist_ok=True)
        link.unlink(missing_ok=True)
        link.symlink_to(node)
    elif not link.exists():
        return [Result("node", "MISSING", f"Node {NODE_VERSION} installed but no {link}")]
    return [Result("node", status, f"v{NODE_VERSION} at {node}, as {link}")]


def cdc_pom(name: str, artifacts: Sequence[tuple[str, str, str]], plugin: bool) -> str:
    """A throwaway pom whose runtime dependencies are one CDC jar set."""
    exclusions = (
        "<exclusions><exclusion><groupId>org.apache.kafka</groupId><artifactId>*</artifactId>"
        "</exclusion><exclusion><groupId>org.slf4j</groupId><artifactId>*</artifactId>"
        "</exclusion></exclusions>"
        if plugin
        else ""
    )
    dependencies = "".join(
        f"<dependency><groupId>{g}</groupId><artifactId>{a}</artifactId><version>{v}</version>"
        f"{exclusions}</dependency>"
        for g, a, v in artifacts
    )
    return (
        '<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>'
        f"<groupId>gluon.sandbox</groupId><artifactId>cdc-{name.replace('/', '-')}</artifactId>"
        f"<version>1</version><dependencies>{dependencies}</dependencies></project>"
    )


def step_cdc(install: bool) -> list[Result]:
    """Kafka, Kafka Connect and Debezium's Postgres connector as jars from Maven Central."""
    marker = CDC_HOME / "COMPLETE"
    status = "OK"
    if not marker.is_file():
        if not install:
            return [Result("cdc", "MISSING", f"jars not in {CDC_HOME} (run without --check)")]
        mvn = MAVEN_HOME / "bin" / "mvn"
        if not mvn.is_file():
            with tempfile.TemporaryDirectory() as scratch:
                tarball = Path(scratch) / "maven.tar.gz"
                urllib.request.urlretrieve(MAVEN_URL, tarball)
                run(["tar", "xzf", str(tarball), "-C", str(MAVEN_HOME.parent)])
        shutil.rmtree(CDC_HOME, ignore_errors=True)
        for name, (artifacts, plugin) in CDC_SETS.items():
            with tempfile.TemporaryDirectory() as scratch:
                (Path(scratch) / "pom.xml").write_text(cdc_pom(name, artifacts, plugin))
                run(
                    [
                        str(mvn),
                        "-q",
                        "-B",
                        "dependency:copy-dependencies",
                        "-DincludeScope=runtime",
                        f"-DoutputDirectory={CDC_HOME / name}",
                    ],
                    cwd=Path(scratch),
                )
        marker.write_text(f"kafka {KAFKA_VERSION}, debezium {DEBEZIUM_VERSION}\n")
        status = "INSTALLED"
    counts = ", ".join(
        f"{name} {len(list((CDC_HOME / name).glob('*.jar')))} jars" for name in CDC_SETS
    )
    return [
        Result(
            "cdc",
            status,
            f"Kafka {KAFKA_VERSION}, Debezium {DEBEZIUM_VERSION} in {CDC_HOME}: {counts}",
        )
    ]


def apt_opts() -> list[str]:
    """apt without root: its state under APT_STATE, no locks, downloads as this user."""
    for sub in ("lists/partial", "cache/archives/partial", "deb"):
        (APT_STATE / sub).mkdir(parents=True, exist_ok=True)
    return [
        "-o",
        f"Dir::State::Lists={APT_STATE / 'lists'}",
        "-o",
        f"Dir::Cache={APT_STATE / 'cache'}",
        "-o",
        "Debug::NoLocking=1",
        "-o",
        f"APT::Sandbox::User={os.environ.get('USER') or Path.home().name}",
    ]


def apt_not_installed(packages: Sequence[str]) -> list[str]:
    """`packages` and everything they depend on (recursively, no recommends) that the
    image hasn't installed: what to unpack so they run here."""
    opts = apt_opts()
    run(["apt-get", *opts, "update"])
    skip = ("--no-recommends", "--no-suggests", "--no-conflicts", "--no-breaks")
    tree = run(
        ["apt-cache", *opts, "depends", "--recurse", *skip, "--no-replaces", "--no-enhances"]
        + list(packages)
    )
    closure = {line for line in tree.splitlines() if line and line[0] not in " <"}
    installed = {
        line.split(":")[0] for line in run(["dpkg-query", "-W", "-f", "${Package}\\n"]).split()
    }
    return sorted(closure - installed)


def apt_unpack(packages: Sequence[str], root: Path) -> None:
    """Downloads `packages`' .debs from Ubuntu's archive and unpacks them into `root`
    (replaced), without root: apt's state lives under APT_STATE."""
    opts = apt_opts()
    run(["apt-get", *opts, "update"])
    debs = APT_STATE / "deb"
    for old in debs.glob("*.deb"):
        old.unlink()
    run(["apt-get", *opts, "download", *packages], cwd=debs)
    shutil.rmtree(root, ignore_errors=True)
    root.mkdir(parents=True)
    for deb in sorted(debs.glob("*.deb")):
        run(["dpkg-deb", "-x", str(deb), str(root)])


def step_vim(install: bool) -> list[Result]:
    """vim 9.1 from Ubuntu's .debs, unpacked without root, with vim/view wrappers."""
    vim = VIM_ROOT / "usr" / "bin" / "vim.basic"
    status = "OK"
    if not vim.is_file():
        if not install:
            return [Result("vim", "MISSING", "vim not unpacked (run without --check)")]
        apt_unpack(VIM_PACKAGES, VIM_ROOT)
        status = "INSTALLED"
    runtime = next((VIM_ROOT / "usr" / "share" / "vim").glob("vim[0-9]*"), None)
    if runtime is None:
        return [Result("vim", "MISSING", f"no vim runtime under {VIM_ROOT}")]
    target = bin_dir()
    if not install:
        if not ((target / "vim").is_file() and (target / "view").is_file()):
            return [Result("vim", "MISSING", f"vim unpacked but no vim/view wrappers in {target}")]
        vimrc = HOME / ".vimrc"
        current = vimrc.read_text(encoding="utf-8") if vimrc.exists() else ""
        if current != VIMRC and (not current or MANAGED_MARK in current.split("\n", 1)[0]):
            return [Result("vim", "MISSING", f"{vimrc} missing or out of date")]
        version = first_line([str(target / "vim"), "--version"])
        if not version:
            return [Result("vim", "MISSING", f"{target / 'vim'} doesn't run (a library missing?)")]
        return [Result("vim", "OK", f"{version}; vim, view in {target}; read-only: vim -M <file>")]
    target.mkdir(parents=True, exist_ok=True)
    write_executable(
        target / "vim",
        "#!/usr/bin/env bash\n"
        "# vim unpacked from Ubuntu's .debs by bin/sandbox-setup (no root in the sandbox).\n"
        f'export VIMRUNTIME="{runtime}"\n'
        f'export LD_LIBRARY_PATH="{VIM_LIB}'
        '${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"\n'
        # The desktop terminal runs as root, whose HOME has no .vimrc: use this one.
        f'[ -f "$HOME/.vimrc" ] || export VIMINIT="source {HOME / ".vimrc"}"\n'
        f'exec "{vim}" "$@"\n',
    )
    write_executable(target / "view", '#!/usr/bin/env bash\nexec vim -R "$@"\n')
    vimrc = HOME / ".vimrc"
    if not vimrc.exists() or MANAGED_MARK in vimrc.read_text(encoding="utf-8").split("\n", 1)[0]:
        vimrc.write_text(VIMRC, encoding="utf-8")
    version = first_line([str(target / "vim"), "--version"])
    return [Result("vim", status, f"{version}; vim, view in {target}; read-only: vim -M <file>")]


def step_shellcheck(install: bool) -> list[Result]:
    """shellcheck from Ubuntu's .deb, unpacked without root, linked onto the PATH
    (lints the bin/ and scripts/ shell scripts; its libraries are the image's)."""
    binary = SHELLCHECK_ROOT / "usr" / "bin" / "shellcheck"
    link = bin_dir() / "shellcheck"
    status = "OK"
    if not binary.is_file():
        if not install:
            return [Result("shellcheck", "MISSING", "not unpacked (run without --check)")]
        apt_unpack(("shellcheck",), SHELLCHECK_ROOT)
        status = "INSTALLED"
    if install:
        link.parent.mkdir(parents=True, exist_ok=True)
        link.unlink(missing_ok=True)
        link.symlink_to(binary)
    elif not link.exists():
        return [Result("shellcheck", "MISSING", f"unpacked but no {link}")]
    version = next(
        (line for line in run([str(binary), "--version"]).splitlines() if "version:" in line),
        "version unknown",
    )
    return [Result("shellcheck", status, f"{version} at {binary}, as {link}")]


def redis_major() -> int | None:
    """The major version of the `redis-server` on the PATH, or None if none runs."""
    match = re.search(r"v=(\d+)\.", first_line(["redis-server", "--version"]))
    return int(match[1]) if match else None


def lib_path(root: Path) -> str:
    """The library directories of .debs unpacked into `root`."""
    return f"{root}/usr/lib/{ARCH.multiarch}:{root}/lib/{ARCH.multiarch}"


def step_redis(install: bool) -> list[Result]:
    """redis-server 7 for the Redis-backed ports' tests (all-Rust prep P6): the image's or
    a mirror's if on the PATH, else Ubuntu's .debs unpacked without root, with wrappers."""
    found, target = shutil.which("redis-server"), bin_dir()
    ours = found is not None and Path(found) == target / "redis-server"
    major = redis_major()
    if major is not None and major >= REDIS_MAJOR:
        where = f"unpacked in {REDIS_ROOT}" if ours else "provided"
        return [Result("redis", "OK", f"{first_line(['redis-server', '--version'])} ({where})")]
    if not install:
        return [Result("redis", "MISSING", f"no redis-server {REDIS_MAJOR} on the PATH")]
    apt_unpack(apt_not_installed(REDIS_PACKAGES), REDIS_ROOT)
    target.mkdir(parents=True, exist_ok=True)
    for tool in ("redis-server", "redis-cli"):
        write_executable(
            target / tool,
            "#!/usr/bin/env bash\n"
            "# Unpacked from Ubuntu's .debs by bin/sandbox-setup (none on the PATH).\n"
            f'export LD_LIBRARY_PATH="{lib_path(REDIS_ROOT)}'
            '${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"\n'
            f'exec "{REDIS_ROOT}/usr/bin/{tool}" "$@"\n',
        )
    version = first_line([str(target / "redis-server"), "--version"])
    if not version:
        return [Result("redis", "MISSING", f"{target / 'redis-server'} doesn't run")]
    return [Result("redis", "INSTALLED", f"{version}; redis-server, redis-cli in {target}")]


def node24_env() -> dict[str, str]:
    """The environment with Node >= 24 (`node24`'s directory) first on the PATH: the npm
    projects' engines; the image's npm and npx run on it."""
    env = dict(os.environ, PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD="1")
    node24 = bin_dir() / "node24"
    if node24.exists():
        env["PATH"] = f"{node24.resolve().parent}{os.pathsep}{env.get('PATH', '')}"
    return env


def npm_dependencies(relative: Path, install: bool) -> Result:
    """An npm project's locked dependencies (`npm ci`), installed once."""
    project = GLUON / relative
    if (project / "node_modules" / ".package-lock.json").is_file():
        return Result("projects", "OK", f"{relative}: node_modules present")
    if not install:
        return Result("projects", "MISSING", f"{relative}: no node_modules (run without --check)")
    run(["npm", "ci", "--no-audit", "--no-fund", "--loglevel=error"], cwd=project, env=node24_env())
    return Result("projects", "INSTALLED", f"{relative}: npm ci")


def headless_shell_revision() -> str:
    """The headless shell revision tests/acceptance's Playwright launches."""
    browsers = ACCEPTANCE / "node_modules" / "playwright-core" / "browsers.json"
    entries = json.loads(browsers.read_text(encoding="utf-8"))["browsers"]
    return next(b["revision"] for b in entries if b["name"] == "chromium-headless-shell")


def browsers_from_upload() -> str | None:
    """Copies the uploaded browsers (bin/fetch-playwright-browsers) into the Playwright
    cache; the upload's name, or None without one."""
    uploads = GLUON.parent
    unpacked = uploads / BROWSERS_UPLOAD
    archives = sorted(uploads.glob(BROWSERS_GLOB))
    with tempfile.TemporaryDirectory() as scratch:
        if not unpacked.is_dir():
            if not archives:
                return None
            run(["tar", "xzf", str(archives[-1]), "-C", scratch])
            unpacked = Path(scratch) / BROWSERS_UPLOAD
        PLAYWRIGHT_CACHE.mkdir(parents=True, exist_ok=True)
        for browser in unpacked.iterdir():
            if (
                browser.is_dir()
                and not browser.name.startswith(".")
                and not (PLAYWRIGHT_CACHE / browser.name).exists()
            ):
                shutil.copytree(browser, PLAYWRIGHT_CACHE / browser.name, symlinks=True)
    return unpacked.name if unpacked.parent == uploads else archives[-1].name


def missing_libraries(binary: Path, libs: Path | None) -> list[str]:
    """The shared libraries `binary` can't find (ldd), with `libs`' unpacked ones added."""
    env = dict(os.environ)
    if libs is not None:
        env["LD_LIBRARY_PATH"] = lib_path(libs)
    out = run(["ldd", str(binary)], env=env)
    return [line.split()[0] for line in out.splitlines() if "not found" in line]


def step_browsers(install: bool) -> list[Result]:
    """Headless Chromium for the acceptance suite (all-Rust prep P6), checked by launching
    it. First what's there: the Playwright cache, then Playwright's own download (a
    mirror may serve it), then the upload; its libraries the image's, else unpacked."""
    if not (ACCEPTANCE / "node_modules" / "@playwright" / "test").is_dir():
        return [Result("browsers", "MISSING", "tests/acceptance has no node_modules (projects)")]
    revision = headless_shell_revision()
    shell = PLAYWRIGHT_CACHE / f"chromium_headless_shell-{revision}"
    status, source = "OK", "the Playwright cache"
    if not (shell / "INSTALLATION_COMPLETE").is_file():
        if not install:
            return [Result("browsers", "MISSING", f"no {shell} (run without --check)")]
        status = "INSTALLED"
        try:
            env = dict(node24_env(), PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT="20000")
            env.pop("PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD")
            run(
                ["npx", "playwright", "install", "--only-shell", "chromium"],
                cwd=ACCEPTANCE,
                env=env,
            )
            source = "Playwright's download"
        except (RuntimeError, subprocess.TimeoutExpired):
            upload = browsers_from_upload()
            if upload is None or not (shell / "INSTALLATION_COMPLETE").is_file():
                return [
                    Result(
                        "browsers",
                        "MISSING",
                        f"no {shell.name}: Playwright's download failed and the upload "
                        f"({BROWSERS_GLOB} beside gluon) lacks it",
                    )
                ]
            source = f"the upload ({upload})"
    binary = next(shell.glob("*/chrome-headless-shell"))
    real = binary.with_name(f"{binary.name}.real")
    libraries = "the image's libraries"
    if missing_libraries(real if real.exists() else binary, None):
        if not install and not real.exists():
            return [Result("browsers", "MISSING", f"{binary} lacks libraries (run setup)")]
        if install and missing_libraries(real if real.exists() else binary, CHROMIUM_LIBS):
            apt_unpack(apt_not_installed(CHROMIUM_LIB_PACKAGES), CHROMIUM_LIBS)
            (CHROMIUM_LIBS / "fonts.conf").write_text(
                f"<fontconfig><dir>{CHROMIUM_LIBS}/usr/share/fonts</dir>"
                "<cachedir>~/.cache/fontconfig</cachedir></fontconfig>\n"
            )
            status = "INSTALLED"
        still = missing_libraries(real if real.exists() else binary, CHROMIUM_LIBS)
        if still:
            return [Result("browsers", "MISSING", f"{binary.name} lacks {', '.join(still)}")]
        if not real.exists():
            binary.rename(real)
            write_executable(
                binary,
                "#!/usr/bin/env bash\n"
                "# Chromium's libraries unpacked from Ubuntu's .debs by bin/sandbox-setup.\n"
                f'export LD_LIBRARY_PATH="{lib_path(CHROMIUM_LIBS)}'
                '${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"\n'
                f'export FONTCONFIG_FILE="{CHROMIUM_LIBS}/fonts.conf"\n'
                f'exec "{real}" "$@"\n',
            )
        libraries = f"libraries unpacked in {CHROMIUM_LIBS}"
    try:
        launched = run(["node", "-e", LAUNCH_PROBE], cwd=ACCEPTANCE, env=node24_env()).strip()
    except (RuntimeError, subprocess.TimeoutExpired) as error:
        return [Result("browsers", "MISSING", f"headless Chromium doesn't launch: {error}")]
    return [
        Result(
            "browsers",
            status,
            f"Chromium {launched.split()[0]} headless shell {revision} from {source}; "
            f"{libraries}; launched, a page rendered",
        )
    ]


def step_shell(install: bool) -> list[Result]:
    """`sr`, `cdw` and `gkube` on the PATH: root's shell files can't be written, so
    commands, not aliases."""
    target = bin_dir()
    aliases, rc = target / "sandbox-aliases", target / "sandbox-shellrc"
    wanted = {
        aliases: SHELL_ALIASES,
        rc: SHELL_RC.format(aliases=aliases),
        target / "cdw": CDW.format(rc=rc),
        target / "sr": SR,
        target / "gkube": GKUBE,
    }
    stale = [
        path for path, text in wanted.items() if not path.is_file() or path.read_text() != text
    ]
    if stale and not install:
        names = ", ".join(path.name for path in stale)
        return [Result("shell", "MISSING", f"{names} missing or out of date in {target}")]
    for path, text in wanted.items():
        write_executable(path, text)
    status = "INSTALLED" if stale else "OK"
    return [
        Result("shell", status, f"sr, cdw, gkube in {target} (cdw opens a shell with the aliases)")
    ]


def export_manifest() -> dict:
    """bin/sandbox-export's EXPORT-MANIFEST.json at gluon's root, or {} without one."""
    try:
        return json.loads((GLUON / EXPORT_MANIFEST).read_text())
    except (OSError, ValueError):
        return {}


def step_git_init(install: bool) -> list[Result]:
    """A git repo in each exported sandbox repo, with the export as its baseline commit.

    The export carries no .git; without one, bin/sandbox-save skips the repo. The
    baseline leaves the export's new captures untracked, so its tree is the laptop
    commit's and later sandbox commits replay onto it (plans/private/sandbox.md).
    """
    results = []
    manifest = export_manifest()
    heads = {Path(repo["path"]): repo["head"] for repo in manifest.get("repos", [])}
    captures = [Path(capture["path"]) for capture in manifest.get("captures", [])]
    for relative in SANDBOX_REPOS:
        repo = GLUON / relative
        if not repo.is_dir():
            results.append(Result("git-init", "INFO", f"{relative} not present"))
            continue
        if (repo / ".git").is_dir():
            results.append(Result("git-init", "OK", f"{relative}: git repo"))
            continue
        if not install:
            results.append(
                Result("git-init", "MISSING", f"{relative}: not a git repo (run without --check)")
            )
            continue
        run(["git", "init", "--quiet", "-b", "main"], cwd=repo)
        for key, value in GIT_IDENTITY.items():
            run(["git", "config", key, value], cwd=repo)
        run(["git", "add", "-A"], cwd=repo)
        for capture in captures:
            if capture.is_relative_to(relative):
                untracked = str(capture.relative_to(relative))
                run(["git", "rm", "-r", "--cached", "--quiet", untracked], cwd=repo)
        head = heads.get(relative, "unknown")[:7]
        message = f"chore(sandbox): baseline from laptop export @ {head}"
        run(["git", "commit", "--quiet", "-m", message], cwd=repo)
        results.append(Result("git-init", "INSTALLED", f"{relative}: baseline @ {head}"))
    return results


def step_git_identity(install: bool) -> list[Result]:
    """A repo-local commit identity in each sandbox-only repo."""
    results = []
    for relative in SANDBOX_REPOS:
        repo = GLUON / relative
        if not (repo / ".git").is_dir():
            results.append(Result("git-identity", "INFO", f"{repo.relative_to(GLUON)} not present"))
            continue
        unset = [
            key for key in GIT_IDENTITY if not first_line(["git", "-C", str(repo), "config", key])
        ]
        if unset and not install:
            results.append(
                Result("git-identity", "MISSING", f"{repo.relative_to(GLUON)}: {unset} unset")
            )
            continue
        for key in unset:
            run(["git", "-C", str(repo), "config", key, GIT_IDENTITY[key]])
        status = "INSTALLED" if unset else "OK"
        results.append(
            Result(
                "git-identity", status, f"{repo.relative_to(GLUON)}: {GIT_IDENTITY['user.name']}"
            )
        )
    return results


def step_projects(install: bool) -> list[Result]:
    """Each sandbox repo's dependencies, from its lock file."""
    results = []
    contract = GLUON / "tests" / "contract"
    if (contract / "uv.lock").is_file():
        venv_ok = (contract / ".venv" / "bin" / "python").is_file()
        if install:
            run(["uv", "sync", "--locked", "--quiet"], cwd=contract)
            results.append(
                Result(
                    "projects", "OK" if venv_ok else "INSTALLED", "tests/contract: uv sync --locked"
                )
            )
        else:
            results.append(
                Result("projects", "OK", "tests/contract: .venv present")
                if venv_ok
                else Result("projects", "MISSING", "tests/contract: no .venv (run without --check)")
            )
    kube = GLUON / "tools" / "gluon-kube"
    if (kube / "uv.lock").is_file():
        kube_venv = (kube / ".venv" / "bin" / "python").is_file()
        if install:
            run(["uv", "sync", "--locked", "--quiet"], cwd=kube)
            results.append(
                Result(
                    "projects",
                    "OK" if kube_venv else "INSTALLED",
                    "tools/gluon-kube: uv sync --locked",
                )
            )
        else:
            results.append(
                Result("projects", "OK", "tools/gluon-kube: .venv present")
                if kube_venv
                else Result(
                    "projects", "MISSING", "tools/gluon-kube: no .venv (run without --check)"
                )
            )
    for relative in SANDBOX_REPOS:
        if (GLUON / relative / "Cargo.lock").is_file():
            results.append(rust_dependencies(relative, install))
    for relative in NPM_PROJECTS:
        if (GLUON / relative / "package-lock.json").is_file():
            results.append(npm_dependencies(relative, install))
    if not results:
        results.append(Result("projects", "INFO", "no sandbox project with a lock file yet"))
    return results


def rust_dependencies(relative: Path, install: bool) -> Result:
    """A Rust repo's locked crates: fetched when installing, and checked present offline
    either way, so a lock the mirror can't serve is reported, not assumed (TD-61)."""
    cargo = str(CARGO_HOME / "bin" / "cargo")
    try:
        if install:
            run([cargo, "fetch", "--locked", "--quiet"], cwd=GLUON / relative)
        run([cargo, "fetch", "--locked", "--offline", "--quiet"], cwd=GLUON / relative)
    except (OSError, RuntimeError) as error:
        why = str(error).strip().splitlines()[-1]
        return Result("projects", "MISSING", f"{relative}: locked crates not all fetched: {why}")
    return Result("projects", "OK", f"{relative}: locked crates fetched")


# --- Helpers ----------------------------------------------------------------


def link_all(source_dir: Path, target_dir: Path) -> None:
    """Symlinks every executable in `source_dir` into `target_dir`, replacing stale links."""
    target_dir.mkdir(parents=True, exist_ok=True)
    for source in sorted(source_dir.iterdir()):
        link = target_dir / source.name
        if link.is_symlink() or not link.exists():
            link.unlink(missing_ok=True)
            link.symlink_to(source)


def write_executable(path: Path, content: str) -> None:
    """Writes a small script and makes it executable."""
    path.write_text(content, encoding="utf-8")
    path.chmod(0o755)


STEPS: dict[str, Callable[[bool], list[Result]]] = {
    "network": step_network,
    "image": step_image,
    "rust": step_rust,
    "node": step_node,
    "cdc": step_cdc,
    "vim": step_vim,
    "shellcheck": step_shellcheck,
    "redis": step_redis,
    "shell": step_shell,
    "git-init": step_git_init,
    "git-identity": step_git_identity,
    "projects": step_projects,
    "browsers": step_browsers,
}


def main(argv: Sequence[str]) -> int:
    """Runs the selected steps and prints the report; 1 if anything is missing."""
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--check", action="store_true", help="report only, install nothing")
    parser.add_argument("--only", nargs="+", choices=list(STEPS), help="run only these steps")
    args = parser.parse_args(argv)
    results: list[Result] = []
    for name in args.only or list(STEPS):
        try:
            results.extend(STEPS[name](not args.check))
        except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
            results.append(Result(name, "MISSING", f"failed: {error}"))
    for result in results:
        print(f"{result.status:<10} {result.step:<13} {result.detail}")
    missing = [r for r in results if r.status == "MISSING"]
    print(f"\n{len(missing)} missing." if missing else "\nSandbox ready.")
    if str(bin_dir()) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"Note: add {bin_dir()} to PATH.")
    return 1 if missing else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
