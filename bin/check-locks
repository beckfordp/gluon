#!/usr/bin/env python3
# SPDX-License-Identifier: MIT

"""Check the Rust repos lock only crates the sandbox can fetch (gluon TD-53.1).

The sandbox's crates.io mirror lags crates.io by days: RPN-5 found ureq 3.5.2
(published three days before) missing, RPN-10 libz-sys 1.1.33 (six days). Then
`cargo fetch --locked` fails in the sandbox and no Rust CI can pass. So every
crates.io crate locked in a SANDBOX_REPOS repo's Cargo.lock must be at least
--days old (default 14). Each younger one is named, with the newest version old
enough, for `cargo update -p NAME --precise VERSION`.

Publish dates come from crates.io's API, one request per crate name, a second
apart (its crawler policy), cached in ~/.cache/gluon/crate-dates.json (a
version's date never changes; a name is fetched again when a locked version
isn't in its entry). CHECK_LOCKS_DATES=FILE reads the dates from FILE instead,
for tests: {"NAME": {"VERSION": ["ISO-8601 date", yanked]}}.

Usage: bin/check-locks [--days N] [--today YYYY-MM-DD] [LOCK ...]
  LOCKs default to every SANDBOX_REPOS repo's Cargo.lock.
Exits 0 when every crate is old enough, 1 when one isn't, 2 when the dates
couldn't be had.
"""

import argparse
import json
import os
import sys
import time
import tomllib
import urllib.error
import urllib.request
from collections.abc import Sequence
from datetime import UTC, date, datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from sandbox import SANDBOX_REPOS  # noqa: E402

GLUON = Path(__file__).resolve().parent.parent
CRATES_IO = "registry+https://github.com/rust-lang/crates.io-index"
API = "https://crates.io/api/v1/crates/{name}"
USER_AGENT = "gluon-check-locks"
CACHE = Path.home() / ".cache" / "gluon" / "crate-dates.json"

Dates = dict[str, dict[str, list]]
"""Per crate name, per version: [publish date (ISO 8601), yanked]."""


class Unavailable(Exception):
    """crates.io couldn't be asked."""


def locked(lock: Path) -> set[tuple[str, str]]:
    """The crates.io crates `lock` pins, as (name, version)."""
    packages = tomllib.loads(lock.read_text()).get("package", [])
    return {(p["name"], p["version"]) for p in packages if p.get("source") == CRATES_IO}


def default_locks() -> list[Path]:
    """Every SANDBOX_REPOS repo's Cargo.lock that exists."""
    return [lock for repo in SANDBOX_REPOS if (lock := GLUON / repo / "Cargo.lock").is_file()]


def fetch(name: str) -> dict[str, list]:
    """Every version of `name` crates.io has, with its date and whether it's yanked."""
    request = urllib.request.Request(API.format(name=name), headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = json.load(response)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
        raise Unavailable(f"{name}: {error}") from error
    return {v["num"]: [v["created_at"], v["yanked"]] for v in body["versions"]}


def dates_for(wanted: set[tuple[str, str]]) -> Dates:
    """Publish dates for every wanted version: from CHECK_LOCKS_DATES, or the cache
    topped up from crates.io."""
    if fixture := os.environ.get("CHECK_LOCKS_DATES"):
        return json.loads(Path(fixture).read_text())
    try:
        cache: Dates = json.loads(CACHE.read_text())
    except (OSError, json.JSONDecodeError):
        cache = {}
    missing = sorted({name for name, version in wanted if version not in cache.get(name, {})})
    if missing:
        print(f"asking crates.io about {len(missing)} crate(s), a second apart", file=sys.stderr)
    try:
        for index, name in enumerate(missing):
            if index:
                time.sleep(1)
            cache[name] = fetch(name)
    finally:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(cache, indent=0, sort_keys=True))
    return cache


def published(dates: Dates, name: str, version: str) -> date | None:
    """When `version` of `name` was published, if known."""
    entry = dates.get(name, {}).get(version)
    return datetime.fromisoformat(entry[0]).astimezone(UTC).date() if entry else None


def newest_before(dates: Dates, name: str, cutoff: date) -> str | None:
    """The newest unyanked version of `name` published on or before `cutoff`."""
    old = [
        (when, version)
        for version, (stamp, yanked) in dates.get(name, {}).items()
        if not yanked and (when := datetime.fromisoformat(stamp).astimezone(UTC).date()) <= cutoff
    ]
    return max(old)[1] if old else None


def young(locks: Sequence[Path], dates: Dates, cutoff: date) -> list[str]:
    """One line per locked crate published after `cutoff` (or never seen)."""
    problems = []
    for lock in locks:
        where = lock.parent.relative_to(GLUON) if lock.is_relative_to(GLUON) else lock.parent
        for name, version in sorted(locked(lock)):
            when = published(dates, name, version)
            if when is not None and when <= cutoff:
                continue
            older = newest_before(dates, name, cutoff)
            fix = f"cargo update -p {name}@{version} --precise {older}" if older else "no older version"
            seen = f"published {when}" if when else "not on crates.io"
            problems.append(f"{where}: {name} {version} {seen} — {fix}")
    return problems


def main(argv: Sequence[str]) -> int:
    """Checks the locks; prints each crate too young for the mirror."""
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--days", type=int, default=14, help="minimum age (default 14)")
    parser.add_argument("--today", type=date.fromisoformat, default=None, help="default: today (UTC)")
    parser.add_argument("locks", nargs="*", type=Path)
    args = parser.parse_args(argv)
    locks = [lock.resolve() for lock in args.locks] or default_locks()
    today = args.today or datetime.now(UTC).date()
    cutoff = today - timedelta(days=args.days)
    wanted = set().union(*(locked(lock) for lock in locks)) if locks else set()
    try:
        dates = dates_for(wanted)
    except Unavailable as error:
        print(f"FAIL: couldn't ask crates.io ({error})", file=sys.stderr)
        return 2
    problems = young(locks, dates, cutoff)
    for line in problems:
        print(line)
    names = ", ".join(str(lock.parent.name) for lock in locks)
    if problems:
        print(f"FAIL: {len(problems)} locked crate(s) newer than {cutoff} ({args.days} days): "
              "the sandbox's mirror may not have them")
        return 1
    print(f"OK: {len(wanted)} crates in {len(locks)} lock(s) ({names}), all published by {cutoff}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
