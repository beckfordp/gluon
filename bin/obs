#!/usr/bin/env bash
# Opt-in observability stack for gluon-local (PLAN.md PERF-3.1–3.4):
# Prometheus + exporters, Elasticsearch/Kibana/Filebeat, Grafana. Kept out
# of bin/k8s-local-up because it costs ~3Gi of the 12Gi laptop budget
# (environments/local/README.md); bring it up only to watch a run.
#
# Usage:
#   bin/obs up [metrics|logs|all]
#                    apply infra/k8s/observability, wait for it, run the
#                    one-shot setup Jobs, print URLs and the memory budget
#   bin/obs down     delete the stack (services and shared infra untouched)
#   bin/obs status   stack pods and the memory budget
#
# Profiles pick the UI (TD-25): both UIs together don't fit beside the
# services and a Gatling run. Prometheus, exporters, Elasticsearch and
# Filebeat run in every profile, so metrics and logs are collected either way.
#   metrics (default)  Grafana, no Kibana — fits the budget
#   logs               Kibana, no Grafana — over the namespace ceiling
#   all                both — over the namespace ceiling
# Switching profile deletes the other UI (objects labelled gluon-obs/ui).
#
# OrbStack serves the stack's LoadBalancer services on localhost:
#   Grafana http://localhost:3000, Kibana http://localhost:5601,
#   Prometheus http://localhost:9092, Alertmanager http://localhost:9093
#
# Exits 3 if the stack is up but over budget (bin/lib/obs-budget.sh): its
# numbers are fine, but a Gatling run beside it would starve the node.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GLUON_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/obs-budget.sh
source "$SCRIPT_DIR/lib/obs-budget.sh"
NAMESPACE="gluon-local"
STACK_DIR="$GLUON_DIR/infra/k8s/observability"
# One-shot Jobs (e.g. kibana-setup) live outside the kustomization: a Job's
# pod template is immutable and it should re-run on every `up`, so it's
# deleted and re-created rather than re-applied.
JOBS_DIR="$STACK_DIR/jobs"
SELECTOR="app.kubernetes.io/part-of=gluon-obs"
WAIT_TIMEOUT="${OBS_WAIT_TIMEOUT:-300s}"
GRAFANA_URL="http://localhost:3000"

usage() { echo "usage: bin/obs up [metrics|logs|all] | down | status" >&2; exit 2; }

[ "$#" -ge 1 ] || usage
cmd="$1"
profile=""
case "$cmd" in
  up)
    [ "$#" -le 2 ] || usage
    profile="${2:-metrics}"
    case "$profile" in metrics|logs|all) ;; *) usage ;; esac
    ;;
  down|status) [ "$#" = 1 ] || usage ;;
  *) usage ;;
esac

# The UI a profile leaves out ("" = none), by its gluon-obs/ui label.
case "$profile" in
  metrics) skip_ui=kibana ;;
  logs) skip_ui=grafana ;;
  *) skip_ui="" ;;
esac

# --- preflight (as bin/run-perf) ---------------------------------------------
if [ "$(kubectl config current-context 2>/dev/null)" != "orbstack" ]; then
  echo "FAIL: kubectl context is not 'orbstack' — switch with 'kubectl config use-context orbstack'" >&2
  exit 1
fi
if ! kubectl get namespace "$NAMESPACE" --request-timeout=5s >/dev/null 2>&1; then
  echo "FAIL: namespace $NAMESPACE missing or cluster unreachable — run bin/k8s-local-up first" >&2
  exit 1
fi

# Pending pods count: their limits are committed even before they schedule.
budget() {
  local pods out code=0
  pods="$(mktemp)"
  kubectl -n "$NAMESPACE" get pods --field-selector=status.phase!=Succeeded,status.phase!=Failed -o json > "$pods"
  out="$(obs_budget_evaluate "$pods")" || code=$?
  rm -f "$pods"
  sed 's/^/  /' <<< "$out"
  return "$code"
}

workloads() {
  kubectl -n "$NAMESPACE" get deployment,statefulset,daemonset -l "$SELECTOR" -o name
}

run_jobs() {
  [ -d "$JOBS_DIR" ] || return 0
  local f job
  for f in "$JOBS_DIR"/*.yaml; do
    [ -e "$f" ] || continue
    if [ -n "$skip_ui" ] && [ "$(kubectl create --dry-run=client -o jsonpath='{.metadata.labels.gluon-obs/ui}' -f "$f")" = "$skip_ui" ]; then
      continue
    fi
    job="$(kubectl create --dry-run=client -o jsonpath='{.metadata.name}' -f "$f")"
    kubectl -n "$NAMESPACE" delete job "$job" --ignore-not-found >/dev/null
    kubectl -n "$NAMESPACE" apply -f "$f" >/dev/null
    if kubectl -n "$NAMESPACE" wait --for=condition=complete "job/$job" --timeout="$WAIT_TIMEOUT" >/dev/null; then
      echo "  job/$job complete"
    else
      echo "FAIL: job/$job didn't complete — kubectl -n $NAMESPACE logs job/$job" >&2
      return 1
    fi
  done
}

# TD-25.3: a fresh Grafana was OOM-killed by its first dashboard-list
# request, so `up` makes that request itself and fails if Grafana restarted.
check_grafana() {
  local tries=30 restarts
  until curl -fsS --max-time 10 "$GRAFANA_URL/api/search?type=dash-db" 2>/dev/null | grep -q '"uid"'; do
    tries=$((tries - 1))
    if [ "$tries" = 0 ]; then
      echo "FAIL: Grafana dashboard list didn't load — kubectl -n $NAMESPACE logs deploy/grafana" >&2
      return 1
    fi
    sleep 2
  done
  restarts="$(kubectl -n "$NAMESPACE" get pods -l app=grafana -o jsonpath='{.items[*].status.containerStatuses[*].restartCount}')"
  if [ -n "$(tr -d ' 0' <<< "$restarts")" ]; then
    echo "FAIL: Grafana restarted ($restarts) during the dashboard-list load — kubectl -n $NAMESPACE describe pod -l app=grafana" >&2
    return 1
  fi
  echo "  Grafana dashboard list loaded"
}

case "$cmd" in
  up)
    echo "== Applying $STACK_DIR (profile: $profile) =="
    if [ -z "$(kubectl kustomize "$STACK_DIR")" ]; then
      echo "  (no resources yet)"
    elif [ -n "$skip_ui" ]; then
      # Select by label in the manifests, not the cluster: objects applied
      # before the label existed are still deleted (by name).
      kubectl delete -k "$STACK_DIR" -l "gluon-obs/ui=$skip_ui" --ignore-not-found >/dev/null
      if [ -d "$JOBS_DIR" ]; then
        kubectl -n "$NAMESPACE" delete -f "$JOBS_DIR" -l "gluon-obs/ui=$skip_ui" --ignore-not-found >/dev/null
      fi
      kubectl -n "$NAMESPACE" wait --for=delete pod -l "app=$skip_ui" --timeout="$WAIT_TIMEOUT" >/dev/null 2>&1 || true
      kubectl apply -k "$STACK_DIR" -l "gluon-obs/ui!=$skip_ui" >/dev/null
    else
      kubectl apply -k "$STACK_DIR" >/dev/null
    fi
    echo "== Waiting for the stack (up to $WAIT_TIMEOUT each) =="
    for w in $(workloads); do
      kubectl -n "$NAMESPACE" rollout status "$w" --timeout="$WAIT_TIMEOUT" >/dev/null || {
        echo "FAIL: $w not ready — kubectl -n $NAMESPACE describe $w" >&2
        exit 1
      }
      echo "  $w ready"
    done
    echo "== One-shot setup Jobs =="
    run_jobs
    if [ "$skip_ui" != grafana ]; then
      echo "== First Grafana load =="
      check_grafana || exit 1
    fi
    echo "== Up =="
    [ "$skip_ui" = grafana ] || echo "  Grafana     $GRAFANA_URL"
    [ "$skip_ui" = kibana ] || echo "  Kibana      http://localhost:5601"
    echo "  Prometheus  http://localhost:9092"
    echo "  Alertmanager http://localhost:9093"
    echo "== Memory budget =="
    budget || {
      echo "WARN: over budget — no room for a Gatling run beside the stack" >&2
      [ "$profile" = metrics ] || echo "  (expected for '$profile'; 'bin/obs up' alone fits beside Gatling)" >&2
      exit 3
    }
    ;;
  down)
    echo "== Deleting the observability stack =="
    if [ -d "$JOBS_DIR" ]; then
      kubectl -n "$NAMESPACE" delete -f "$JOBS_DIR" --ignore-not-found >/dev/null
    fi
    if [ -n "$(kubectl kustomize "$STACK_DIR")" ]; then
      kubectl delete -k "$STACK_DIR" --ignore-not-found >/dev/null
    fi
    kubectl -n "$NAMESPACE" wait --for=delete pod -l "$SELECTOR" --timeout="$WAIT_TIMEOUT" >/dev/null 2>&1 || true
    echo "== Memory budget =="
    budget || true
    ;;
  status)
    echo "== Stack pods =="
    kubectl -n "$NAMESPACE" get pods -l "$SELECTOR" 2>&1 | sed 's/^/  /'
    echo "== Memory budget =="
    budget
    ;;
esac
