#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Run the Playwright acceptance suite (PLAN.md ACC-6.2, ADR 0020) against
# gluon-local: gshop driven in Chromium against the real services.
#
# The suite lives in tests/acceptance (gluon-acceptance). This script checks
# the cluster and toolchain, checks the user-story coverage matrix, resets
# every database and reseeds (bin/reset-data), runs the suite, checks reserved
# stock still matches the reservation ledger (bin/check-stock-ledger, TD-24),
# then opens the report.
#
# Usage:
#   bin/run-acceptance [--no-open] [--gkube] [playwright args...]
#     --no-open        don't serve the HTML report afterwards
#     --gkube          against gluon-kube (the sandbox, the sandbox bed: all-Rust Stage
#                      B), not OrbStack: every Service port-forwarded
#                      (bin/lib/gkube-forwards.sh; GKUBE_FORWARD_ADDRESS, default
#                      127.0.0.1), the suite and the seed pointed at the forwards, and
#                      kubectl a stand-in passing to gkube (bin/lib/gkube-kubectl). The
#                      forwards stop when the run ends
#     playwright args  passed through, e.g. --grep @US-17 or --headed
#
# Staged (all-Rust Stage A P0.5): ACCEPTANCE_SERVICES=cart,catalog limits the
# connector precheck, reset, seeding, the suite's precheck and the ledger check to
# those services (bin/lib/acceptance-services.sh); unset, the original run.
#
# Exits with Playwright's status, or 1 if a preflight check or the coverage
# matrix fails. A changed inventory is a warning, not a failure: a scenario
# that failed mid-way may legitimately leave it changed.
# Outputs: tests/acceptance/playwright-report/, target/coverage-matrix.md
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GLUON_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SUITE_DIR="$GLUON_DIR/tests/acceptance"
NAMESPACE="gluon-local"
GSHOP_PORT=5173
# shellcheck source=bin/lib/connectors.sh
. "$SCRIPT_DIR/lib/connectors.sh"
# shellcheck source=bin/lib/acceptance-services.sh
. "$SCRIPT_DIR/lib/acceptance-services.sh"
# shellcheck source=bin/lib/gkube-forwards.sh
. "$SCRIPT_DIR/lib/gkube-forwards.sh"

usage() { echo "usage: bin/run-acceptance [--no-open] [--gkube] [playwright args...]" >&2; exit 2; }

open_report=true
gkube=false
args=()
for arg in "$@"; do
  case "$arg" in
    --no-open) open_report=false ;;
    --gkube) gkube=true ;;
    -h|--help) usage ;;
    *) args+=("$arg") ;;
  esac
done

node_major() { "$1" -v 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/'; }

# --- preflight ---------------------------------------------------------------
acceptance_validate || exit 2
if acceptance_staged; then
  echo "== Staged: $(acceptance_list | paste -sd, -) (ACCEPTANCE_SERVICES; unset for the full run) =="
fi
if $gkube; then
  if ! gkube cluster status > /dev/null 2>&1; then
    echo "FAIL: no gluon-kube cluster — run 'gkube cluster start && gkube up' first" >&2
    exit 1
  fi
  export GLUON_KUBE=1 PATH="$SCRIPT_DIR/lib/gkube-kubectl:$PATH"
  trap gkube_forwards_stop EXIT
  echo "== Port-forwarding every Service (gkube port-forward) =="
  gkube_forwards_start "${GKUBE_FORWARD_ADDRESS:-127.0.0.1}" "$GLUON_DIR/target/gkube" || exit 1
  while IFS= read -r url; do export "${url?}"; done < <(gkube_urls)
elif [ "$(kubectl config current-context 2>/dev/null)" != "orbstack" ]; then
  echo "FAIL: kubectl context is not 'orbstack' — switch with 'kubectl config use-context orbstack'" >&2
  exit 1
fi
if ! kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
  echo "FAIL: namespace $NAMESPACE missing — run bin/k8s-local-up (or gkube up) first" >&2
  exit 1
fi
if [ ! -d "$SUITE_DIR" ]; then
  echo "FAIL: $SUITE_DIR missing — clone beckfordp/gluon-acceptance there" >&2
  exit 1
fi
# The suite pins Node 26 (.nvmrc; engines >= 24); a shell's PATH may still have an
# older node first, so fall back to nvm's newest installed 26, or the sandbox's node24
# (bin/sandbox-setup).
if [ "$(node_major node || echo 0)" -lt 24 ]; then
  # `|| true`: no nvm node 26 (the sandbox's case) isn't an error under pipefail.
  nvm26=$(ls -d "${NVM_DIR:-$HOME/.nvm}"/versions/node/v26.* 2>/dev/null | sort -V | tail -1 || true)
  if [ -n "$nvm26" ] && [ -x "$nvm26/bin/node" ]; then
    export PATH="$nvm26/bin:$PATH"
  elif node24=$(command -v node24) && [ "$(node_major "$node24" || echo 0)" -ge 24 ]; then
    node24_dir=$(dirname "$(readlink -f "$node24")")
    export PATH="$node24_dir:$PATH"
  else
    echo "FAIL: node $(node -v 2>/dev/null || echo missing); need >= 24 (nvm install 26)" >&2
    exit 1
  fi
fi
if [ ! -d "$SUITE_DIR/node_modules" ]; then
  echo "FAIL: suite dependencies missing — run 'npm ci' in $SUITE_DIR" >&2
  exit 1
fi
# Without its outbox connector a service's events never reach Kafka, and seeding
# fails later without saying why (TD-49).
staged_connectors_check() {
  local name state bad=0
  for name in $(connector_names | acceptance_connectors); do
    state="$(connector_state "$name")"
    if [ "$state" != RUNNING ]; then
      echo "connector $name: $state" >&2
      bad=1
    fi
  done
  return "$bad"
}
if ! staged_connectors_check; then
  echo "FAIL: outbox connectors not RUNNING — run bin/k8s-local-up (it re-registers and restarts them)" >&2
  exit 1
fi
# Playwright would reuse a dev server already on the port, possibly one wired to mocks.
if curl -s -m 2 -o /dev/null "http://localhost:$GSHOP_PORT"; then
  echo "FAIL: :$GSHOP_PORT already in use — stop that gshop dev server first" >&2
  exit 1
fi

cd "$SUITE_DIR"

# --- coverage matrix ---------------------------------------------------------
echo "== Coverage matrix =="
GLUON_DIR="$GLUON_DIR" npm run -s coverage:matrix || {
  echo "FAIL: coverage matrix has problems — see $SUITE_DIR/target/coverage-matrix.md" >&2
  exit 1
}

# --- reset + seed ------------------------------------------------------------
# Every run starts from a known baseline; scenarios never restore data (TD-24).
echo "== Reset and seed =="
"$GLUON_DIR/bin/reset-data" --yes < /dev/null

# --- suite -------------------------------------------------------------------
echo "== Acceptance suite =="
npx bddgen < /dev/null
status=0
npx playwright test "${args[@]+"${args[@]}"}" < /dev/null || status=$?

if acceptance_covers inventory; then
  echo "== Stock ledger invariant =="
  "$GLUON_DIR/bin/check-stock-ledger" || status=1
else
  echo "== Stock ledger invariant: skipped (inventory not in ACCEPTANCE_SERVICES) =="
fi

# --- report ------------------------------------------------------------------
# show-report serves until Ctrl+C, so only when someone is there to close it.
if $open_report && [ -t 1 ]; then
  echo "== Report (Ctrl+C to stop serving) =="
  npx playwright show-report || true
else
  echo "Report: $SUITE_DIR/playwright-report/index.html (npx playwright show-report)"
fi
exit "$status"
