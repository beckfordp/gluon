#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Verifies laptop session RPN-0.1 (PLAN.md, Rust Port — notification-service),
# each check printed PASS or FAIL as it finishes:
#   1. bin/sandbox-export exports gluon, SHARED_REPOS (apps/gfood among them) and the
#      PORTS repos that exist, and no other nested repo (a real export, to a temp directory)
#   2. its reference check warns for a repo not exported, and not for an
#      exported repo, an allowed file or Markdown
#   3. bin/sandbox-save warns for a git repo not in SANDBOX_REPOS, not for listed ones
#      (apps/gfood is one); gluon itself keeps only apps/README.md
#   4. the touched Python scripts compile
#   5. a default export carries the gluon-kube plan
#   6. a --no-plans export carries no plan and no live track, and keeps Conductor's
#      workflow, gluon-kube's included (no repo is read-only for it now)
#   7. --prefix names the archive; tracks.md loses a section's items, not its
#      headings, separators or intro (the laptop's layout, for clean imports)
#   8. bin/check-locks names a locked crate too young for the sandbox's mirror,
#      with the version to go back to, and passes locks old enough (TD-53.1)
# Logs go to a run directory, printed at the start. Exits 1 on any FAIL.
#   bin/verify-sandbox-tools
set -uo pipefail
GLUON="$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")"
cd "$GLUON" || exit 1

LOGS="${TMPDIR:-/tmp}/verify-sandbox-tools.$(date +%Y%m%d-%H%M%S)"
mkdir -p "$LOGS"
echo "RPN-0.1 done criteria — logs in $LOGS"

PASSED=0
FAILED=0
# check LABEL LOG PYTHON: PASS if the Python snippet exits 0; it gets `export`
# (bin/sandbox-export), `save` (bin/sandbox-save) and `sandbox` (bin/lib/sandbox.py)
check() {
  local label="$1" log="$LOGS/$2"
  echo "     $label"
  if PYTHONDONTWRITEBYTECODE=1 python3 - > "$log" 2>&1 <<EOF
import importlib.machinery, importlib.util, sys, tempfile
from pathlib import Path
def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(module)
    return module
export = load("sandbox_export", "bin/sandbox-export")
save = load("sandbox_save", "bin/sandbox-save")
import sandbox
$3
EOF
  then
    echo "PASS $label"
    PASSED=$((PASSED + 1))
  else
    echo "FAIL $label: $(tail -n 1 "$log") (log: $log)"
    FAILED=$((FAILED + 1))
  fi
}

check "export carries the ports and shared repos, no other" export.log '
with tempfile.TemporaryDirectory() as out:
    manifest = export.export(Path(out) / "gluon", [], False)
got = {repo["path"] for repo in manifest["repos"]}
scala = ["user", "notification", "cart", "catalog", "inventory", "fulfilment", "payment", "order"]
want = {".", "tests/contract", "lib/purerest", "lib/gluon-rs", "tools/gluon-kube",
        "tools/rust-service-template", "tests/acceptance", "frontends/gshop",
        *(f"services/{s}-service" for s in scala)}
want |= {f"services/{s}-service-rs" for s in scala if Path(f"services/{s}-service-rs").is_dir()}
want |= {"apps/gfood"} if Path("apps/gfood").is_dir() else set()
print("exported:", sorted(got))
print("warnings:", manifest["unexported_refs"])
sys.exit(0 if got == want else f"want {sorted(want)}, got {sorted(got)}")'

check "default export carries the gluon-kube plan" plans.log '
with tempfile.TemporaryDirectory() as out:
    root = Path(out) / "gluon"
    manifest = export.export(root, [], False)
    plan = (root / "plans" / "gluon-kube" / "plan.md").is_file()
print("plan:", plan, "plans:", manifest["plans"])
sys.exit(0 if plan and manifest["plans"] else "gluon-kube plan missing")'

check "--no-plans export carries no plan and no live track" noplans.log '
with tempfile.TemporaryDirectory() as out:
    root = Path(out) / "gluon"
    manifest = export.export(root, [], False, plans=False)
    plans = sorted(str(p.relative_to(root)) for p in (root / "plans").rglob("*")) if (root / "plans").exists() else []
    live = sorted(str(p.relative_to(root)) for p in root.rglob("conductor/tracks/*"))
    kube = (root / "tools" / "gluon-kube" / "conductor" / "workflow.md").is_file()
    workflow = (root / "tests" / "contract" / "conductor" / "workflow.md").is_file()
    listed = [line for p in root.rglob("conductor/tracks.md")
              for line in p.read_text().split("## Tracks", 1)[-1].split("## Backlog", 1)[0].splitlines()
              if line.startswith("- [")]
    review = (root / "EXPORT-REVIEW.md").read_text()
print("plans:", plans, "live:", live, "gluon-kube conductor:", kube, "workflow:", workflow, "listed:", listed)
sys.exit(0 if not plans and not live and kube and workflow and not listed
         and not manifest["plans"] and "--no-plans" in review else "plan material exported")'

check "--prefix names the archive; tracks.md keeps its layout, loses its items" prefix.log '
names = (export.archive_name(Path("w/gluon"), "spike"), export.archive_name(Path("w/gluon"), None))
cases = [
    ("# T\n\n## Tracks\n\n- [~] **Track: x**\n  *Link: [./tracks/x/](./tracks/x/)*\n\n---\n\n## Backlog\n- y\n",
     "# T\n\n## Tracks\n\n---\n\n## Backlog\n"),
    ("## Tracks\n\n---\n\n- [~] **Track: x**\n*Link: [./tracks/x/](./tracks/x/)*\n\n---\n\n## Backlog\n"
     "\nIntro, kept.\n\n- a\n- b\n",
     "## Tracks\n\n---\n\n---\n\n## Backlog\n\nIntro, kept.\n\n"),
    ("## Tracks\n\n\n---\n\n## Backlog\n", "## Tracks\n\n\n---\n\n## Backlog\n"),
]
got = [export.strip_items(export.strip_backlog(text), "Tracks") for text, _ in cases]
print(names, [repr(g) for g in got])
sys.exit(0 if names == ("spike-gluon.tar.gz", "gluon.tar.gz")
         and got == [want for _, want in cases] else "unexpected")'

check "gluon keeps only apps/README.md of apps/; gfood is its own repo" apps.log '
files = [str(f) for f in sandbox.platform_files() if f.parts[0] == "apps"]
print("gluon files in apps/:", files, "nested dirs:", sandbox.NESTED_REPO_DIRS)
sys.exit(0 if files == ["apps/README.md"] else f"unexpected gluon files in apps/: {files}")'

check "reference check warns only for a repo not exported" refs.log '
with tempfile.TemporaryDirectory() as scratch:
    staging = Path(scratch)
    for name, text in {
        "bin/run-thing": "cd tools/pure-service-generator\n",
        "bin/uses-exported": "cd services/user-service\n",
        "bin/run-perf": "cd tests/performance\n",
        "docs/note.md": "see tools/pure-service-generator\n",
    }.items():
        (staging / name).parent.mkdir(parents=True, exist_ok=True)
        (staging / name).write_text(text)
    found, allowed = export.unexported_refs(staging, sandbox.export_repos())
print("found:", found, "allowed:", dict(allowed))
sys.exit(0 if found == ["bin/run-thing:1: tools/pure-service-generator"] and sum(allowed.values()) == 1
         else "unexpected warnings")'

check "sandbox-save warns only for unlisted git repos" save.log '
with tempfile.TemporaryDirectory() as scratch:
    root = Path(scratch)
    for repo in ("tests/contract", "services/user-service-rs", "services/foo-rs", "apps/gfood", "apps/bar"):
        (root / repo / ".git").mkdir(parents=True)
    (root / "services" / "not-a-repo").mkdir()
    missing = save.unsaved(root)
print("unsaved:", missing)
sys.exit(0 if missing == [Path("apps/bar"), Path("services/foo-rs")] else "unexpected unsaved list")'

check "check-locks names a crate too young for the mirror" locks.log '
import contextlib, io, json, os
locks = load("check_locks", "bin/check-locks")
with tempfile.TemporaryDirectory() as scratch:
    root = Path(scratch)
    lock = root / "Cargo.lock"
    lock.write_text("""version = 4
[[package]]
name = "ureq"
version = "3.5.2"
source = "registry+https://github.com/rust-lang/crates.io-index"
[[package]]
name = "cc"
version = "1.11.0"
source = "registry+https://github.com/rust-lang/crates.io-index"
[[package]]
name = "local"
version = "0.1.0"
""")
    dates = root / "dates.json"
    dates.write_text(json.dumps({
        "ureq": {"3.5.0": ["2026-10-01T00:00:00Z", False], "3.5.1": ["2026-10-20T00:00:00Z", True],
                 "3.5.2": ["2026-11-12T11:20:05Z", False]},
        "cc": {"1.11.0": ["2026-10-02T00:00:00Z", False]},
    }))
    os.environ["CHECK_LOCKS_DATES"] = str(dates)
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        young = locks.main(["--today", "2026-11-19", str(lock)])
        old = locks.main(["--today", "2026-11-30", "--days", "14", str(lock)])
print(out.getvalue())
want = "ureq 3.5.2 published 2026-11-12 — cargo update -p ureq@3.5.2 --precise 3.5.0"
sys.exit(0 if young == 1 and old == 0 and want in out.getvalue() and "cc " not in out.getvalue().split("FAIL")[0]
         else f"young={young} old={old}")'

echo "     python scripts compile"
if python3 - > "$LOGS/compile.log" 2>&1 <<'EOF'
import sys
for path in ("bin/sandbox-export", "bin/sandbox-save", "bin/lib/sandbox.py", "bin/check-locks"):
    compile(open(path).read(), path, "exec")
EOF
then
  echo "PASS python scripts compile"
  PASSED=$((PASSED + 1))
else
  echo "FAIL python scripts compile: $(tail -n 1 "$LOGS/compile.log")"
  FAILED=$((FAILED + 1))
fi

TOTAL=$((PASSED + FAILED))
if [ "$FAILED" = 0 ]; then
  echo "PASS: RPN-0.1 complete ($PASSED/$TOTAL; logs in $LOGS)"
else
  echo "FAIL: $FAILED of $TOTAL failed (logs in $LOGS)"
  exit 1
fi
